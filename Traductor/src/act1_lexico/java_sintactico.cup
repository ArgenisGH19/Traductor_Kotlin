package act1_lexico;

import java_cup.runtime.*;

parser code {:
    // ¡Nuestra memoria semántica intacta!
    public TablaSimbolos tablaSimbolos = new TablaSimbolos();

    // --- 1. CONTADORES GLOBALES Y VARIABLES DE ESTADO ---
    public int totalErrores = 0;
    public boolean errorFatal = false;
    
    public int ultimaLinea = -1;
    public int ultimaColumna = -1;
    public String ultimoToken = "";

    // --- 2. EL ATRAPAMOSCAS ---
    @Override
    public void syntax_error(Symbol s) {
        totalErrores++;
        ultimaLinea = s.left;
        ultimaColumna = s.right;
        ultimoToken = (s.value != null) ? s.value.toString() : "desconocido";
    }

    // --- 3. MANEJO DE ERROR FATAL ---
    @Override
    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        errorFatal = true;
        ultimaLinea = s.left;
        ultimaColumna = s.right;
        throw new Exception("Error sintactico irrecuperable");
    }

    // --- 4. NUESTRO GENERADOR DE DIAGNÓSTICOS (EN ROJO) ---
    public void imprimirDiagnostico(String descripcion, String esperado, String sugerencia, String ejemplo) {
        System.err.println("========================================================");
        System.err.println("ERROR SINTACTICO #" + totalErrores);
        System.err.println("========================================================");
        System.err.println("Ubicacion: Linea " + ultimaLinea + ", columna " + ultimaColumna);
        System.err.println("Elemento encontrado: '" + ultimoToken + "'\n");
        
        System.err.println("Descripcion:");
        System.err.println(descripcion + "\n");
        
        System.err.println("Elemento esperado:");
        System.err.println(esperado + "\n");
        
        System.err.println("Sugerencia:");
        System.err.println(sugerencia + "\n");
        
        if (ejemplo != null && !ejemplo.isEmpty()) {
            System.err.println("Ejemplo de posible correccion:");
            System.err.println(ejemplo + "\n");
        }
        
        System.err.println("Estado:");
        System.err.println("Error recuperable. El analisis continuara.");
        System.err.println("========================================================\n");
    }
// --- LÓGICA DE ANÁLISIS SEMÁNTICO Y TIPOS ---
    public String validarOperacionAritmetica(String tipo1, String tipo2, String operador, int linea, int columna) {
        if (tipo1.equals("error") || tipo2.equals("error")) return "error";

        if (operador.equals("+") && (tipo1.equals("String") || tipo2.equals("String"))) {
            return "String"; // Concatenación permitida
        }

        if ((tipo1.equals("int") || tipo1.equals("float") || tipo1.equals("double")) && 
            (tipo2.equals("int") || tipo2.equals("float") || tipo2.equals("double"))) {
            
            // Promoción de tipos
            if (tipo1.equals("double") || tipo2.equals("double")) return "double";
            if (tipo1.equals("float") || tipo2.equals("float")) return "float";
            return "int";
        }
        
        ManejoErrores.agregarSemantico("El operador aritmético '" + operador + "' no es aplicable a los tipos '" + tipo1 + "' y '" + tipo2 + "'.", linea, columna);
        return "error";
    }

    public String validarOperacionLogicaRelacional(String tipo1, String tipo2, String operador, int linea, int columna) {
        if (tipo1.equals("error") || tipo2.equals("error")) return "error";

        boolean esRelacional = operador.matches("<|>|<=|>=|==|!=");
        boolean esLogico = operador.matches("&&|\\|\\|");

        if (esRelacional) {
            if ((tipo1.equals("int") || tipo1.equals("float") || tipo1.equals("double")) && 
                (tipo2.equals("int") || tipo2.equals("float") || tipo2.equals("double"))) {
                return "boolean";
            }
            if ((operador.equals("==") || operador.equals("!=")) && tipo1.equals(tipo2)) {
                return "boolean";
            }
            ManejoErrores.agregarSemantico("No se pueden comparar los tipos '" + tipo1 + "' y '" + tipo2 + "' con el operador '" + operador + "'.", linea, columna);
        } else if (esLogico) {
            if (tipo1.equals("boolean") && tipo2.equals("boolean")) {
                return "boolean";
            }
            ManejoErrores.agregarSemantico("El operador lógico '" + operador + "' requiere operandos 'boolean', se encontró '" + tipo1 + "' y '" + tipo2 + "'.", linea, columna);
        }
        return "error";
    }

    public boolean sonTiposCompatibles(String tipoDestino, String tipoValor) {
        if (tipoValor.equals("error")) return true; // Ignorar en cascada
        if (tipoDestino.equals(tipoValor)) return true;
        if (tipoDestino.equals("float") && tipoValor.equals("int")) return true; // int cabe en float
        if (tipoDestino.equals("double") && (tipoValor.equals("int") || tipoValor.equals("float"))) return true;
        if (tipoDestino.equals("String")) return true; // Asumimos que todo se puede hacer string
        return false;
    }
:};

// --- DECLARACIÓN DE TERMINALES ---
terminal String PACKAGE, IMPORT, CLASS, FUN, VAL, VAR, IF, ELSE, WHEN, WHILE, DO, FOR, IN;
terminal String PUBLIC, PRIVATE, PROTECTED, INTERNAL, FINAL, RETURN, NULL, TRUE, FALSE;
terminal String PLUS, MINUS, MULT, DIV, MOD, EQ, EQEQ, NEQ, LT, LE, GT, GE, AND, OR, NOT;
terminal String ARROW, RANGE, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK, COMMA, SEMICOLON, DOT, COLON;
terminal String INT, FLOAT, DOUBLE, CHAR, BOOLEAN, STRING;
terminal String LEER, ESCRIBIR;
terminal String IDENTIFIER, INT_LITERAL, FLOAT_LITERAL, DOUBLE_LITERAL, CHAR_LITERAL, STRING_LITERAL, ERROR;

// --- DECLARACIÓN DE NO TERMINALES ---
non terminal programa, estructura_paquete, lista_importaciones, importacion, ruta;
non terminal lista_metodos, metodo, cuerpo_metodo, lista_sentencias, sentencia, bloque;
non terminal seleccion, seleccion_multiple, lista_casos, caso, defecto;
non terminal ciclo_mientras, ciclo_hacer_mientras, ciclo_para;
non terminal lectura, escritura, asignacion, retorno;
non terminal lista_identificadores, lista_elementos, rango_para;
non terminal String expresion, condicion, elemento;
non terminal parametros_optativos, lista_parametros, parametro, tipo_retorno_optativo;


// Agregados de la Actividad 8
non terminal llamada_metodo, lista_argumentos;

// Agregados de la Tabla de Símbolos
non terminal clase_principal, marcador_clase, marcador_metodo;
non terminal String tipo_dato;

// --- PRECEDENCIA DE OPERADORES ---
precedence nonassoc IF;
precedence nonassoc ELSE;
precedence left OR;
precedence left AND;
precedence right NOT;
precedence nonassoc EQEQ, NEQ, LT, LE, GT, GE;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;

start with programa;

// --- REGLAS GRAMATICALES GLOBALES ---

programa ::= estructura_paquete lista_importaciones clase_principal
           | lista_importaciones clase_principal
           | estructura_paquete clase_principal
           | clase_principal
           | error 
           {: parser.unrecovered_syntax_error(cur_token); :}
           ;

estructura_paquete ::= PACKAGE ruta SEMICOLON 
                     {: System.out.println("Regla reconocida: estructura_paquete"); :}
                     | PACKAGE error SEMICOLON 
                     {: parser.imprimirDiagnostico("Estructura de paquete malformada.", "Una ruta de paquete valida (ej. com.mi.paquete).", "Asegurate de especificar el nombre del paquete correctamente y cerrar con ';'.", "package com.mi.paquete;"); :}
                     ;

lista_importaciones ::= lista_importaciones importacion
                      | importacion
                      ;

importacion ::= IMPORT ruta SEMICOLON 
              {: System.out.println("Regla reconocida: importacion"); :}
              | IMPORT error SEMICOLON 
              {: parser.imprimirDiagnostico("Declaracion de importacion invalida.", "Una ruta de paquete o clase a importar.", "Verifica la sintaxis de la importacion.", "import java.util.*;"); :}
              ;

ruta ::= IDENTIFIER
       | ruta DOT IDENTIFIER
       ;

// --- REGISTRO SEMÁNTICO DE CLASES ---
marcador_clase ::= CLASS IDENTIFIER:id
                 {:
                     parser.tablaSimbolos.agregarSimbolo(id, "CLASE", "void", "N/A", idleft, idright);
                     parser.tablaSimbolos.entrarAmbito(id);
                 :}
                 ;

clase_principal ::= marcador_clase LBRACE lista_metodos RBRACE 
                  {: 
                     parser.tablaSimbolos.salirAmbito(); 
                     System.out.println("Regla reconocida: clase_principal_con_metodos"); 
                  :}
                  | marcador_clase LBRACE RBRACE 
                  {: 
                     parser.tablaSimbolos.salirAmbito(); 
                     System.out.println("Regla reconocida: clase_principal_vacia"); 
                  :}
                  | CLASS error RBRACE 
                  {: parser.imprimirDiagnostico("Error en la definicion de la clase principal.", "Un identificador valido para la clase seguido de llaves {}.", "Revisa el nombre de la clase y su estructura.", "class MiClase { ... }"); :}
                  ;

lista_metodos ::= lista_metodos metodo
                | metodo
                ;

// --- REGISTRO SEMÁNTICO DE MÉTODOS ---
marcador_metodo ::= FUN IDENTIFIER:id
                  {:
                     parser.tablaSimbolos.agregarSimbolo(id, "METODO", "void", "N/A", idleft, idright);
                     parser.tablaSimbolos.entrarAmbito(id);
                  :}
                  ;

metodo ::= marcador_metodo LPAREN parametros_optativos RPAREN tipo_retorno_optativo LBRACE cuerpo_metodo RBRACE
         {: 
             parser.tablaSimbolos.salirAmbito(); 
             System.out.println("Regla reconocida: definicion_metodo"); 
         :}
         | FUN IDENTIFIER error LBRACE cuerpo_metodo RBRACE 
         {: parser.imprimirDiagnostico("Falta la lista de parametros delimitada por parentesis en la declaracion del metodo.", "Parentesis () despues del identificador.", "Agrega () despues del nombre del metodo, incluso si no recibe parametros.", "fun iniciar() {"); :}
         ;

tipo_retorno_optativo ::= COLON tipo_dato 
                        {: System.out.println("Regla reconocida: metodo_con_retorno"); :}
                        | /* vacio */ 
                        {: System.out.println("Regla reconocida: metodo_sin_retorno"); :}
                        ;

parametros_optativos ::= lista_parametros 
                       {: System.out.println("Regla reconocida: metodo_con_parametros"); :}
                       | /* vacio */ 
                       {: System.out.println("Regla reconocida: metodo_sin_parametros"); :}
                       ;

lista_parametros ::= parametro
                   | lista_parametros COMMA parametro
                   | lista_parametros COMMA error 
                   {: parser.imprimirDiagnostico("Se encontro un elemento invalido o coma duplicada en los parametros.", "Un identificador de parametro (ej. a: int).", "Verifica no tener comas duplicadas o parametros vacios.", "fun sumar(a: int, b: int)"); :}
                   ;

// --- REGISTRO SEMÁNTICO DE PARÁMETROS ---
parametro ::= IDENTIFIER:id COLON tipo_dato:tipo 
            {: 
                parser.tablaSimbolos.agregarSimbolo(id, "VARIABLE", tipo, "N/A (Parametro)", idleft, idright); 
                System.out.println("Regla reconocida: parametro valido"); 
            :}
            | error COLON tipo_dato 
            {: parser.imprimirDiagnostico("Se esperaba un nombre para el parametro.", "Un identificador valido antes de los dos puntos.", "Asegurate de nombrar el parametro.", "valor: int"); :}
            | IDENTIFIER COLON error 
            {: parser.imprimirDiagnostico("Tipo de dato invalido o faltante en el parametro.", "Un tipo de dato valido (int, float, etc.).", "Declara el tipo de dato despues de los dos puntos.", "valor: int"); :}
            ;

tipo_dato ::= INT {: RESULT = "int"; :} 
            | FLOAT {: RESULT = "float"; :} 
            | DOUBLE {: RESULT = "double"; :} 
            | CHAR {: RESULT = "char"; :} 
            | BOOLEAN {: RESULT = "boolean"; :} 
            | STRING {: RESULT = "String"; :} 
            | IDENTIFIER:id {: RESULT = id; :} 
            ;

cuerpo_metodo ::= lista_sentencias 
                {: System.out.println("Regla reconocida: cuerpo_metodo"); :}
                | /* vacio */ 
                {: System.out.println("Regla reconocida: cuerpo de metodo vacio"); :}
                ;

// --- BLOQUES Y SENTENCIAS ---
bloque ::= LBRACE lista_sentencias RBRACE 
         {: System.out.println("Regla reconocida: bloque"); :}
         | LBRACE RBRACE 
         {: System.out.println("Regla reconocida: bloque_vacio"); :}
         | LBRACE error RBRACE 
         {: parser.imprimirDiagnostico("Error de sintaxis dentro del bloque de codigo.", "Instrucciones validas.", "Revisa las sentencias dentro de las llaves { }.", ""); :}
         ;

lista_sentencias ::= lista_sentencias sentencia
                   | sentencia
                   ;

sentencia ::= seleccion
            | seleccion_multiple
            | ciclo_mientras
            | ciclo_hacer_mientras
            | ciclo_para
            | lectura
            | escritura
            | asignacion
            | retorno
            | llamada_metodo SEMICOLON 
            {: System.out.println("Regla reconocida: llamada utilizada como sentencia"); :}
            | error SEMICOLON 
            {: parser.imprimirDiagnostico("Instruccion no reconocida o malformada.", "Una sentencia valida.", "Verifica la estructura de la instruccion. Si es una llamada a metodo sin parametros, agregale '()'.", "iniciar();"); :}
            ;

// --- 1. ESTRUCTURAS SELECTIVAS ---
seleccion ::= IF LPAREN condicion RPAREN bloque
            {: System.out.println("Regla reconocida: seleccion_simple"); :}
            | IF LPAREN condicion RPAREN bloque ELSE bloque
            {: System.out.println("Regla reconocida: seleccion_doble"); :}
            | IF error RPAREN bloque
            {: parser.imprimirDiagnostico("Condicion malformada o falta de parentesis de apertura en 'if'.", "Un parentesis '(' seguido de una condicion.", "Agrega el parentesis de apertura para la condicion.", "if (x > 0) {"); :}
            ;

seleccion_multiple ::= WHEN LPAREN expresion RPAREN LBRACE lista_casos defecto RBRACE
                     {: System.out.println("Regla reconocida: seleccion_multiple"); :}
                     | WHEN LPAREN expresion RPAREN LBRACE lista_casos RBRACE
                     {: System.out.println("Regla reconocida: seleccion_multiple"); :}
                     | WHEN LPAREN error RPAREN LBRACE lista_casos RBRACE
                     {: parser.imprimirDiagnostico("Expresion invalida en estructura 'when'.", "Una variable o expresion a evaluar.", "Verifica el contenido entre los parentesis del when.", "when (opcion) {"); :}
                     ;

lista_casos ::= lista_casos caso | caso ;
caso ::= expresion ARROW bloque {: System.out.println("Regla reconocida: caso"); :} 
       | expresion ARROW sentencia {: System.out.println("Regla reconocida: caso"); :} ;
defecto ::= ELSE ARROW bloque {: System.out.println("Regla reconocida: defecto"); :} 
          | ELSE ARROW sentencia {: System.out.println("Regla reconocida: defecto"); :} ;

// --- 2. ESTRUCTURAS ITERATIVAS ---
ciclo_mientras ::= WHILE LPAREN condicion RPAREN bloque
                 {: System.out.println("Regla reconocida: ciclo_mientras"); :}
                 | WHILE LPAREN condicion error bloque
                 {: parser.imprimirDiagnostico("Falta el parentesis de cierre en el ciclo 'while'.", "Un parentesis de cierre ')'.", "Cierra los parentesis de la condicion.", "while (x < 10) {"); :}
                 ;

ciclo_hacer_mientras ::= DO bloque WHILE LPAREN condicion RPAREN SEMICOLON
                       {: System.out.println("Regla reconocida: ciclo_hacer_mientras"); :}
                       | DO bloque WHILE LPAREN error RPAREN SEMICOLON
                       {: parser.imprimirDiagnostico("Condicion invalida en el ciclo 'do-while'.", "Una expresion booleana.", "Revisa la condicion dentro de los parentesis.", "while (x < 10);"); :}
                       ;

ciclo_para ::= FOR LPAREN IDENTIFIER IN rango_para RPAREN bloque
             {: System.out.println("Regla reconocida: ciclo_para"); :}
             | FOR LPAREN IDENTIFIER RPAREN bloque
             {: parser.imprimirDiagnostico("Se esperaba la seccion de actualizacion o rango en el ciclo 'for'.", "La palabra reservada 'in' seguida de un rango.", "Agrega la palabra 'in' y el rango a iterar.", "for (i in 1..10) {"); :}
             ;

rango_para ::= expresion RANGE expresion ;

// --- EXPRESIONES CON VERIFICACIÓN DE TIPOS ---
expresion ::= expresion:e1 PLUS expresion:e2 
            {: RESULT = parser.validarOperacionAritmetica(e1, e2, "+", e1left, e1right); :}
            | expresion:e1 MINUS expresion:e2 
            {: RESULT = parser.validarOperacionAritmetica(e1, e2, "-", e1left, e1right); :}
            | expresion:e1 MULT expresion:e2 
            {: RESULT = parser.validarOperacionAritmetica(e1, e2, "*", e1left, e1right); :}
            | expresion:e1 DIV expresion:e2 
            {: RESULT = parser.validarOperacionAritmetica(e1, e2, "/", e1left, e1right); :}
            | expresion:e1 MOD expresion:e2 
            {: RESULT = parser.validarOperacionAritmetica(e1, e2, "%", e1left, e1right); :}
            | expresion:e1 EQEQ expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, "==", e1left, e1right); :}
            | expresion:e1 NEQ expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, "!=", e1left, e1right); :}
            | expresion:e1 LT expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, "<", e1left, e1right); :}
            | expresion:e1 LE expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, "<=", e1left, e1right); :}
            | expresion:e1 GT expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, ">", e1left, e1right); :}
            | expresion:e1 GE expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, ">=", e1left, e1right); :}
            | expresion:e1 AND expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, "&&", e1left, e1right); :}
            | expresion:e1 OR expresion:e2 
            {: RESULT = parser.validarOperacionLogicaRelacional(e1, e2, "||", e1left, e1right); :}
            | NOT expresion:e1 
            {: 
                if(!e1.equals("boolean") && !e1.equals("error")) {
                    ManejoErrores.agregarSemantico("El operador '!' requiere un operando 'boolean'.", e1left, e1right);
                }
                RESULT = "boolean"; 
            :}
            | LPAREN expresion:e1 RPAREN 
            {: RESULT = e1; :}
            | IDENTIFIER:id 
            {: 
                Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                if (s == null) {
                    ManejoErrores.agregarSemantico("El identificador '" + id + "' no ha sido declarado en este ambito.", idleft, idright);
                    RESULT = "error";
                } else {
                    RESULT = s.getTipoDato();
                }
            :}
            | INT_LITERAL {: RESULT = "int"; :}
            | FLOAT_LITERAL {: RESULT = "float"; :}
            | DOUBLE_LITERAL {: RESULT = "double"; :}
            | CHAR_LITERAL {: RESULT = "char"; :}
            | STRING_LITERAL {: RESULT = "String"; :}
            | TRUE {: RESULT = "boolean"; :}
            | FALSE {: RESULT = "boolean"; :}
            | NULL {: RESULT = "null"; :}
            | llamada_metodo 
            {: RESULT = "void"; /* Por ahora asume void, o ajusta si tus métodos retornan tipo */ :}
            ;

condicion ::= expresion:e 
            {: 
                if(!e.equals("boolean") && !e.equals("error")) {
                   ManejoErrores.agregarSemantico("La expresión de la condición debe ser de tipo 'boolean', se encontró '" + e + "'.", eleft, eright);
                }
                RESULT = e;
            :} ;

elemento ::= expresion:e {: RESULT = e; :};

// --- ASIGNACIÓN CON VERIFICACIÓN SEMÁNTICA ---
asignacion ::= IDENTIFIER:id EQ expresion:exp SEMICOLON 
             {: 
                 Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                 if (s == null) {
                     ManejoErrores.agregarSemantico("El identificador '" + id + "' no ha sido declarado.", idleft, idright);
                 } else {
                     if (s.getCategoria().equals("CONSTANTE")) {
                         ManejoErrores.agregarSemantico("No se puede reasignar un valor a la constante '" + id + "'.", idleft, idright);
                     } else if (!parser.sonTiposCompatibles(s.getTipoDato(), exp)) {
                         ManejoErrores.agregarSemantico("Incompatibilidad de tipos: No se puede asignar '" + exp + "' a '" + id + "' de tipo '" + s.getTipoDato() + "'.", idleft, idright);
                     }
                 }
             :}
             | VAR IDENTIFIER:id COLON tipo_dato:tipo EQ expresion:exp SEMICOLON 
             {: 
                 if (!parser.sonTiposCompatibles(tipo, exp)) {
                     ManejoErrores.agregarSemantico("Incompatibilidad de tipos al inicializar la variable '" + id + "'. Se esperaba '" + tipo + "' pero se recibió '" + exp + "'.", idleft, idright);
                 }
                 parser.tablaSimbolos.agregarSimbolo(id, "VARIABLE", tipo, "Asignado", idleft, idright); 
             :}
             | VAL IDENTIFIER:id COLON tipo_dato:tipo EQ expresion:exp SEMICOLON 
             {: 
                 if (!parser.sonTiposCompatibles(tipo, exp)) {
                     ManejoErrores.agregarSemantico("Incompatibilidad de tipos al inicializar la constante '" + id + "'. Se esperaba '" + tipo + "' pero se recibió '" + exp + "'.", idleft, idright);
                 }
                 parser.tablaSimbolos.agregarSimbolo(id, "CONSTANTE", tipo, "Asignado", idleft, idright); 
             :}
             | error EQ expresion SEMICOLON 
             {: parser.imprimirDiagnostico("Identificador faltante en la asignacion.", "El nombre de una variable.", "Coloca el nombre de la variable antes del signo '='.", "total = 10;"); :}
             | IDENTIFIER EQ error SEMICOLON 
             {: parser.imprimirDiagnostico("Se esperaba una expresion despues del operador de asignacion.", "Un valor, variable o expresion matematica compatible.", "Proporciona un valor despues del '='.", "total = 10;"); :}
             ;


// --- OTRAS SENTENCIAS ---
lectura ::= LEER LPAREN lista_identificadores RPAREN SEMICOLON 
          {: System.out.println("Regla reconocida: sentencia de lectura"); :}
          | LEER LPAREN error RPAREN SEMICOLON 
          {: parser.imprimirDiagnostico("Estructura invalida en sentencia de lectura.", "Una lista de variables a leer.", "Revisa los argumentos dentro de leer().", "leer(variable);"); :}
          ;

lista_identificadores ::= IDENTIFIER
                        | lista_identificadores COMMA IDENTIFIER
                        | lista_identificadores COMMA error 
                        {: parser.imprimirDiagnostico("Coma duplicada o elemento faltante en lista de lectura.", "Un identificador valido.", "Elimina la coma sobrante o agrega el identificador.", "leer(var1, var2);"); :}
                        ;

escritura ::= ESCRIBIR LPAREN lista_elementos RPAREN SEMICOLON 
            {: System.out.println("Regla reconocida: sentencia de escritura"); :}
            | ESCRIBIR LPAREN lista_elementos error SEMICOLON 
            {: parser.imprimirDiagnostico("No se encontro el parentesis de cierre en la escritura.", "Un parentesis ')'.", "Agrega el parentesis de cierre antes del punto y coma.", "escribir(\"Hola\");"); :}
            | ESCRIBIR error SEMICOLON 
            {: parser.imprimirDiagnostico("Estructura invalida en sentencia de escritura.", "Parentesis y contenido a escribir.", "Verifica la sintaxis de la instruccion escribir.", "escribir(\"Hola\");"); :}
            ;

lista_elementos ::= elemento | lista_elementos COMMA elemento ;

retorno ::= RETURN expresion SEMICOLON 
          {: System.out.println("Regla reconocida: retorno con expresion"); :}
          | RETURN SEMICOLON 
          {: System.out.println("Regla reconocida: retorno sin expresion"); :}
          | RETURN error SEMICOLON 
          {: parser.imprimirDiagnostico("Expresion invalida en sentencia return.", "Un valor o variable a retornar.", "Verifica lo que estas intentando retornar.", "return a + b;"); :}
          ;

// --- LLAMADAS A MÉTODOS ---
llamada_metodo ::= IDENTIFIER LPAREN RPAREN 
                 {: System.out.println("Regla reconocida: llamada_sin_argumentos"); :}
                 | IDENTIFIER LPAREN lista_argumentos RPAREN 
                 {: System.out.println("Regla reconocida: llamada_metodo_con_argumentos"); :}
                 | IDENTIFIER LPAREN error RPAREN 
                 {: parser.imprimirDiagnostico("Estructura incompleta o invalida en los argumentos de la llamada.", "Una lista de argumentos validos separados por comas.", "Verifica los valores que le pasas al metodo.", "sumar(a, b);"); :}
                 ;

lista_argumentos ::= expresion 
                   {: System.out.println("Regla reconocida: argumento procesado"); :}
                   | lista_argumentos COMMA expresion
                   | lista_argumentos COMMA error 
                   {: parser.imprimirDiagnostico("Se encontro una coma adicional o un argumento vacio al final.", "Un valor o expresion despues de la coma.", "Elimina la coma adicional o proporciona el argumento faltante.", "sumar(a, b)"); :}
                   | error COMMA expresion 
                   {: parser.imprimirDiagnostico("Se esperaba una expresion antes de la coma.", "Un valor o argumento valido.", "Proporciona el argumento faltante o elimina la coma si no es necesaria.", "sumar(a, b)"); :}
                   ;