package act1_lexico;

import java_cup.runtime.*;
import java.util.List;
import java.util.ArrayList;

parser code {:
    // ¡Nuestra memoria semántica intacta!
    public TablaSimbolos tablaSimbolos = new TablaSimbolos();

    // --- 1. CONTADORES GLOBALES Y VARIABLES DE ESTADO ---
    public int totalErrores = 0;
    public boolean errorFatal = false;
    
    public int ultimaLinea = -1;
    public int ultimaColumna = -1;
    public String ultimoToken = "";

    // --- NUEVO: CÓDIGO DE 3 DIRECCIONES (C3D) ---
    public List<String> codigoIntermedio = new ArrayList<>();
    private int contadorTemp = 0;
    private int contadorEtiq = 0;

    public String generarTemp() {
        return "T" + (contadorTemp++);
    }

    public String generarEtiq() {
        return "L" + (contadorEtiq++);
    }

    // --- 2. EL ATRAPAMOSCAS ---
    @Override
    public void syntax_error(Symbol s) {
        totalErrores++;
        ultimaLinea = s.left;
        ultimaColumna = s.right;
        ultimoToken = (s.value != null) ? s.value.toString() : "desconocido";
    }

    // --- 3. MANEJO DE ERROR FATAL ---
    @Override
    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        errorFatal = true;
        ultimaLinea = s.left;
        ultimaColumna = s.right;
        throw new Exception("Error sintactico irrecuperable");
    }

    // --- 4. NUESTRO GENERADOR DE DIAGNÓSTICOS ---
    public void imprimirDiagnostico(String descripcion, String esperado, String sugerencia, String ejemplo) {
        System.err.println("========================================================");
        System.err.println("ERROR SINTACTICO #" + totalErrores);
        System.err.println("========================================================");
        System.err.println("Ubicacion: Linea " + ultimaLinea + ", columna " + ultimaColumna);
        System.err.println("Elemento encontrado: '" + ultimoToken + "'\n");
        
        System.err.println("Descripcion:");
        System.err.println(descripcion + "\n");
        
        System.err.println("Elemento esperado:");
        System.err.println(esperado + "\n");
        
        System.err.println("Sugerencia:");
        System.err.println(sugerencia + "\n");
        
        if (ejemplo != null && !ejemplo.isEmpty()) {
            System.err.println("Ejemplo de posible correccion:");
            System.err.println(ejemplo + "\n");
        }
        
        System.err.println("Estado:");
        System.err.println("Error recuperable. El analisis continuara.");
        System.err.println("========================================================\n");
    }

    // --- LÓGICA DE ANÁLISIS SEMÁNTICO Y TIPOS ---
    public String validarOperacionAritmetica(String tipo1, String tipo2, String operador, int linea, int columna) {
        if (tipo1.equals("error") || tipo2.equals("error")) return "error";

        if (operador.equals("+") && (tipo1.equals("String") || tipo2.equals("String"))) {
            return "String"; 
        }

        if ((tipo1.equals("int") || tipo1.equals("float") || tipo1.equals("double")) && 
            (tipo2.equals("int") || tipo2.equals("float") || tipo2.equals("double"))) {
            if (tipo1.equals("double") || tipo2.equals("double")) return "double";
            if (tipo1.equals("float") || tipo2.equals("float")) return "float";
            return "int";
        }
        
        System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": El operador aritmetico '" + operador + "' no es aplicable a los tipos '" + tipo1 + "' y '" + tipo2 + "'.");
        return "error";
    }

    public String validarOperacionLogicaRelacional(String tipo1, String tipo2, String operador, int linea, int columna) {
        if (tipo1.equals("error") || tipo2.equals("error")) return "error";

        boolean esRelacional = operador.matches("<|>|<=|>=|==|!=");
        boolean esLogico = operador.matches("&&|\\|\\|");

        if (esRelacional) {
            if ((tipo1.equals("int") || tipo1.equals("float") || tipo1.equals("double")) && 
                (tipo2.equals("int") || tipo2.equals("float") || tipo2.equals("double"))) {
                return "boolean";
            }
            if ((operador.equals("==") || operador.equals("!=")) && tipo1.equals(tipo2)) {
                return "boolean";
            }
            System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": No se pueden comparar los tipos '" + tipo1 + "' y '" + tipo2 + "' con el operador '" + operador + "'.");
        } else if (esLogico) {
            if (tipo1.equals("boolean") && tipo2.equals("boolean")) {
                return "boolean";
            }
            System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": El operador logico '" + operador + "' requiere operandos 'boolean', se encontro '" + tipo1 + "' y '" + tipo2 + "'.");
        }
        return "error";
    }

    public boolean sonTiposCompatibles(String tipoDestino, String tipoValor) {
        if (tipoValor.equals("error")) return true; 
        if (tipoDestino.equals(tipoValor)) return true;
        if (tipoDestino.equals("float") && tipoValor.equals("int")) return true; 
        if (tipoDestino.equals("double") && (tipoValor.equals("int") || tipoValor.equals("float"))) return true;
        if (tipoDestino.equals("String")) return true; 
        return false;
    }

    public String validarLlamadaMetodo(String id, List<NodoExp> argsExp, int linea, int columna) {
        Simbolo s = tablaSimbolos.obtenerSimbolo(id);
        if (s == null) {
            System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": El metodo '" + id + "' no esta declarado.");
            return "error";
        }
        if (!s.getCategoria().equals("METODO")) {
            System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": El identificador '" + id + "' no es un metodo.");
            return "error";
        }
        
        List<String> params = s.getTiposParametros();
        if (params.size() != argsExp.size()) {
            System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": El metodo '" + id + "' requiere " + params.size() + " argumentos, pero se proporcionaron " + argsExp.size() + ".");
            return "error";
        }
        
        for (int i = 0; i < params.size(); i++) {
            String tipoArg = argsExp.get(i).tipo;
            if (!sonTiposCompatibles(params.get(i), tipoArg)) {
                System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": El argumento " + (i+1) + " del metodo '" + id + "' es de tipo '" + tipoArg + "'; se esperaba un tipo compatible con '" + params.get(i) + "'.");
            }
        }
        return s.getTipoDato(); 
    }

    public void validarRetorno(String tipoRetornado, int linea, int columna) {
        String tipoEsperado = tablaSimbolos.getTipoRetornoActual();
        if (!sonTiposCompatibles(tipoEsperado, tipoRetornado)) {
            System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": El metodo declara un retorno de tipo '" + tipoEsperado + "', pero la expresion retornada es de tipo '" + tipoRetornado + "'.");
        }
    }

    public void validarBreakContinue(String instruccion, int linea, int columna) {
        if (!tablaSimbolos.estoyEnUnCiclo()) {
            System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": La instruccion '" + instruccion + "' no se encuentra dentro de un ciclo (for, while, do-while).");
        }
    }
:};

// --- DECLARACIÓN DE TERMINALES ---
terminal String PACKAGE, IMPORT, CLASS, FUN, VAL, VAR, IF, ELSE, WHEN, WHILE, DO, FOR, IN;
terminal String PUBLIC, PRIVATE, PROTECTED, INTERNAL, FINAL, RETURN, NULL, TRUE, FALSE;
terminal String PLUS, MINUS, MULT, DIV, MOD, EQ, EQEQ, NEQ, LT, LE, GT, GE, AND, OR, NOT;
terminal String ARROW, RANGE, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK, COMMA, SEMICOLON, DOT, COLON;
terminal String INT, FLOAT, DOUBLE, CHAR, BOOLEAN, STRING;
terminal String LEER, ESCRIBIR, BREAK, CONTINUE;
terminal String IDENTIFIER, INT_LITERAL, FLOAT_LITERAL, DOUBLE_LITERAL, CHAR_LITERAL, STRING_LITERAL, ERROR;

// --- DECLARACIÓN DE NO TERMINALES ---
non terminal programa, estructura_paquete, lista_importaciones, importacion, ruta;
non terminal lista_metodos, metodo, cuerpo_metodo, lista_sentencias, sentencia, bloque;
non terminal seleccion, seleccion_multiple, lista_casos, caso, defecto;
non terminal ciclo_mientras, ciclo_hacer_mientras, ciclo_para, marcador_ciclo;
non terminal lectura, escritura, asignacion, retorno;
non terminal lista_identificadores, lista_elementos, rango_para;
non terminal parametros_optativos, lista_parametros, parametro, tipo_retorno_optativo;

// C3D: Modificados para usar NodoExp
non terminal NodoExp expresion, condicion, elemento, llamada_metodo;
non terminal List<NodoExp> lista_argumentos;

non terminal clase_principal, marcador_clase, marcador_metodo;
non terminal String tipo_dato;

// --- PRECEDENCIA DE OPERADORES ---
precedence nonassoc IF;
precedence nonassoc ELSE;
precedence left OR;
precedence left AND;
precedence right NOT;
precedence nonassoc EQEQ, NEQ, LT, LE, GT, GE;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;

start with programa;

// --- REGLAS GRAMATICALES GLOBALES ---

programa ::= estructura_paquete lista_importaciones clase_principal
           | lista_importaciones clase_principal
           | estructura_paquete clase_principal
           | clase_principal
           | error 
           {: parser.unrecovered_syntax_error(cur_token); :}
           ;

estructura_paquete ::= PACKAGE ruta SEMICOLON 
                     {: System.out.println("Regla reconocida: estructura_paquete"); :}
                     | PACKAGE error SEMICOLON 
                     {: parser.imprimirDiagnostico("Estructura de paquete malformada.", "Una ruta de paquete valida (ej. com.mi.paquete).", "Asegurate de especificar el nombre del paquete correctamente y cerrar con ';'.", "package com.mi.paquete;"); :}
                     ;

lista_importaciones ::= lista_importaciones importacion | importacion ;

importacion ::= IMPORT ruta SEMICOLON 
              {: System.out.println("Regla reconocida: importacion"); :}
              | IMPORT error SEMICOLON 
              {: parser.imprimirDiagnostico("Declaracion de importacion invalida.", "Una ruta de paquete o clase a importar.", "Verifica la sintaxis de la importacion.", "import java.util.*;"); :}
              ;

ruta ::= IDENTIFIER | ruta DOT IDENTIFIER ;

marcador_clase ::= CLASS IDENTIFIER:id
                 {:
                     parser.tablaSimbolos.agregarSimbolo(id, "CLASE", "void", "N/A", idleft, idright);
                     parser.tablaSimbolos.entrarAmbito(id);
                 :}
                 ;

clase_principal ::= marcador_clase LBRACE lista_metodos RBRACE 
                  {: 
                     parser.tablaSimbolos.salirAmbito(); 
                     System.out.println("Regla reconocida: clase_principal_con_metodos"); 
                  :}
                  | marcador_clase LBRACE RBRACE 
                  {: 
                     parser.tablaSimbolos.salirAmbito(); 
                     System.out.println("Regla reconocida: clase_principal_vacia"); 
                  :}
                  | CLASS error RBRACE 
                  {: parser.imprimirDiagnostico("Error en la definicion de la clase principal.", "Un identificador valido para la clase seguido de llaves {}.", "Revisa el nombre de la clase y su estructura.", "class MiClase { ... }"); :}
                  ;

lista_metodos ::= lista_metodos metodo | metodo ;

marcador_metodo ::= FUN IDENTIFIER:id
                  {:
                     parser.tablaSimbolos.agregarSimbolo(id, "METODO", "void", "N/A", idleft, idright);
                     parser.tablaSimbolos.entrarAmbito(id);
                     parser.tablaSimbolos.setTipoRetornoActual("void");
                     parser.codigoIntermedio.add("\nproc " + id + " begin");
                  :}
                  ;

metodo ::= marcador_metodo LPAREN parametros_optativos RPAREN tipo_retorno_optativo LBRACE cuerpo_metodo RBRACE
         {: 
             parser.tablaSimbolos.salirAmbito(); 
             parser.codigoIntermedio.add("end proc\n");
             System.out.println("Regla reconocida: definicion_metodo"); 
         :}
         | FUN IDENTIFIER error LBRACE cuerpo_metodo RBRACE 
         {: parser.imprimirDiagnostico("Falta la lista de parametros delimitada por parentesis en la declaracion del metodo.", "Parentesis () despues del identificador.", "Agrega () despues del nombre del metodo, incluso si no recibe parametros.", "fun iniciar() {"); :}
         ;

tipo_retorno_optativo ::= COLON tipo_dato:t 
                        {: 
                            parser.tablaSimbolos.setTipoRetornoActual(t);
                            Simbolo s = parser.tablaSimbolos.obtenerSimbolo(parser.tablaSimbolos.getAmbitoActual());
                            if(s != null) s.setTipoDato(t);
                            System.out.println("Regla reconocida: metodo_con_retorno"); 
                        :}
                        | /* vacio */ 
                        {: System.out.println("Regla reconocida: metodo_sin_retorno"); :}
                        ;

parametros_optativos ::= lista_parametros {: System.out.println("Regla reconocida: metodo_con_parametros"); :}
                       | /* vacio */ {: System.out.println("Regla reconocida: metodo_sin_parametros"); :}
                       ;

lista_parametros ::= parametro
                   | lista_parametros COMMA parametro
                   | lista_parametros COMMA error 
                   {: parser.imprimirDiagnostico("Se encontro un elemento invalido o coma duplicada en los parametros.", "Un identificador de parametro (ej. a: int).", "Verifica no tener comas duplicadas o parametros vacios.", "fun sumar(a: int, b: int)"); :}
                   ;

parametro ::= IDENTIFIER:id COLON tipo_dato:tipo 
            {: 
                parser.tablaSimbolos.agregarSimbolo(id, "VARIABLE", tipo, "N/A (Parametro)", idleft, idright); 
                parser.tablaSimbolos.registrarParametroEnMetodoActual(tipo);
                System.out.println("Regla reconocida: parametro valido"); 
            :}
            | error COLON tipo_dato 
            {: parser.imprimirDiagnostico("Se esperaba un nombre para el parametro.", "Un identificador valido antes de los dos puntos.", "Asegurate de nombrar el parametro.", "valor: int"); :}
            | IDENTIFIER COLON error 
            {: parser.imprimirDiagnostico("Tipo de dato invalido o faltante en el parametro.", "Un tipo de dato valido (int, float, etc.).", "Declara el tipo de dato despues de los dos puntos.", "valor: int"); :}
            ;

tipo_dato ::= INT {: RESULT = "int"; :} 
            | FLOAT {: RESULT = "float"; :} 
            | DOUBLE {: RESULT = "double"; :} 
            | CHAR {: RESULT = "char"; :} 
            | BOOLEAN {: RESULT = "boolean"; :} 
            | STRING {: RESULT = "String"; :} 
            | IDENTIFIER:id {: RESULT = id; :} 
            ;

cuerpo_metodo ::= lista_sentencias {: System.out.println("Regla reconocida: cuerpo_metodo"); :}
                | /* vacio */ {: System.out.println("Regla reconocida: cuerpo de metodo vacio"); :}
                ;

bloque ::= LBRACE lista_sentencias RBRACE {: System.out.println("Regla reconocida: bloque"); :}
         | LBRACE RBRACE {: System.out.println("Regla reconocida: bloque_vacio"); :}
         | LBRACE error RBRACE {: parser.imprimirDiagnostico("Error de sintaxis dentro del bloque de codigo.", "Instrucciones validas.", "Revisa las sentencias dentro de las llaves { }.", ""); :}
         ;

lista_sentencias ::= lista_sentencias sentencia | sentencia ;

sentencia ::= seleccion | seleccion_multiple | ciclo_mientras | ciclo_hacer_mientras | ciclo_para
            | lectura | escritura | asignacion | retorno
            | llamada_metodo:m SEMICOLON 
            {: 
                System.out.println("Regla reconocida: llamada utilizada como sentencia"); 
                // C3D: Si se requiere, se puede generar 'call m.lugar' aqui
            :}
            | BREAK:b SEMICOLON 
            {: 
               parser.validarBreakContinue("break", bleft, bright); 
               parser.codigoIntermedio.add("goto L_END_LOOP"); // Etiqueta generica de salto (se afina en C3D completo)
               System.out.println("Regla reconocida: instruccion break"); 
            :}
            | CONTINUE:c SEMICOLON 
            {: 
               parser.validarBreakContinue("continue", cleft, cright); 
               parser.codigoIntermedio.add("goto L_START_LOOP"); 
               System.out.println("Regla reconocida: instruccion continue"); 
            :}
            | error SEMICOLON {: parser.imprimirDiagnostico("Instruccion no reconocida o malformada.", "Una sentencia valida.", "Verifica la estructura de la instruccion.", "iniciar();"); :}
            ;

// --- 1. ESTRUCTURAS SELECTIVAS ---
seleccion ::= IF LPAREN condicion:c RPAREN bloque 
            {: 
                parser.codigoIntermedio.add("if " + c.lugar + " == false goto L_END_IF");
                System.out.println("Regla reconocida: seleccion_simple"); 
            :}
            | IF LPAREN condicion:c RPAREN bloque ELSE bloque 
            {: 
                System.out.println("Regla reconocida: seleccion_doble"); 
            :}
            | IF error RPAREN bloque {: parser.imprimirDiagnostico("Condicion malformada o falta de parentesis de apertura en 'if'.", "Un parentesis '(' seguido de una condicion.", "Agrega el parentesis de apertura para la condicion.", "if (x > 0) {"); :}
            ;

seleccion_multiple ::= WHEN LPAREN expresion:e RPAREN LBRACE lista_casos defecto RBRACE {: System.out.println("Regla reconocida: seleccion_multiple"); :}
                     | WHEN LPAREN expresion:e RPAREN LBRACE lista_casos RBRACE {: System.out.println("Regla reconocida: seleccion_multiple"); :}
                     | WHEN LPAREN error RPAREN LBRACE lista_casos RBRACE {: parser.imprimirDiagnostico("Expresion invalida en estructura 'when'.", "Una variable o expresion a evaluar.", "Verifica el contenido entre los parentesis del when.", "when (opcion) {"); :}
                     ;

lista_casos ::= lista_casos caso | caso ;
caso ::= expresion:e ARROW bloque {: System.out.println("Regla reconocida: caso"); :} 
       | expresion:e ARROW sentencia {: System.out.println("Regla reconocida: caso"); :} ;
defecto ::= ELSE ARROW bloque {: System.out.println("Regla reconocida: defecto"); :} 
          | ELSE ARROW sentencia {: System.out.println("Regla reconocida: defecto"); :} ;

marcador_ciclo ::= /* vacio */ {: parser.tablaSimbolos.entrarCiclo(); :} ;

ciclo_mientras ::= WHILE LPAREN condicion:c RPAREN marcador_ciclo bloque
                 {: parser.tablaSimbolos.salirCiclo(); System.out.println("Regla reconocida: ciclo_mientras"); :}
                 | WHILE LPAREN condicion:c error bloque
                 {: parser.tablaSimbolos.salirCiclo(); parser.imprimirDiagnostico("Falta el parentesis de cierre en el ciclo 'while'.", "Un parentesis de cierre ')'.", "Cierra los parentesis de la condicion.", "while (x < 10) {"); :}
                 ;

ciclo_hacer_mientras ::= DO marcador_ciclo bloque WHILE LPAREN condicion:c RPAREN SEMICOLON
                       {: parser.tablaSimbolos.salirCiclo(); System.out.println("Regla reconocida: ciclo_hacer_mientras"); :}
                       | DO marcador_ciclo bloque WHILE LPAREN error RPAREN SEMICOLON
                       {: parser.tablaSimbolos.salirCiclo(); parser.imprimirDiagnostico("Condicion invalida en el ciclo 'do-while'.", "Una expresion booleana.", "Revisa la condicion dentro de los parentesis.", "while (x < 10);"); :}
                       ;

ciclo_para ::= FOR LPAREN IDENTIFIER IN rango_para RPAREN marcador_ciclo bloque
             {: parser.tablaSimbolos.salirCiclo(); System.out.println("Regla reconocida: ciclo_para"); :}
             | FOR LPAREN IDENTIFIER RPAREN marcador_ciclo bloque
             {: parser.tablaSimbolos.salirCiclo(); parser.imprimirDiagnostico("Se esperaba la seccion de actualizacion o rango en el ciclo 'for'.", "La palabra reservada 'in' seguida de un rango.", "Agrega la palabra 'in' y el rango a iterar.", "for (i in 1..10) {"); :}
             ;

rango_para ::= expresion:e1 RANGE expresion:e2 ;

// --- EXPRESIONES CON VERIFICACIÓN DE TIPOS Y GENERACIÓN C3D ---
expresion ::= expresion:e1 PLUS expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "+", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " + " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 MINUS expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "-", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " - " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 MULT expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "*", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " * " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 DIV expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "/", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " / " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 MOD expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "%", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " % " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 EQEQ expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "==", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " == " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 NEQ expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "!=", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " != " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 LT expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "<", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " < " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 LE expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "<=", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " <= " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 GT expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, ">", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " > " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 GE expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, ">=", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " >= " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 AND expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "&&", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " && " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | expresion:e1 OR expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "||", e1left, e1right);
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = " + e1.lugar + " || " + e2.lugar);
                RESULT = new NodoExp(t, tipo); 
            :}
            | NOT expresion:e1 
            {: 
                if(!e1.tipo.equals("boolean") && !e1.tipo.equals("error")) {
                    System.err.println("Error semantico en linea " + e1left + ", columna " + e1right + ": El operador '!' requiere un operando 'boolean'.");
                }
                String t = parser.generarTemp();
                parser.codigoIntermedio.add(t + " = !" + e1.lugar);
                RESULT = new NodoExp(t, "boolean"); 
            :}
            | LPAREN expresion:e1 RPAREN {: RESULT = e1; :}
            | IDENTIFIER:id 
            {: 
                Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                String tipoResultante;
                if (s == null) {
                    System.err.println("Error semantico en linea " + idleft + ", columna " + idright + ": El identificador '" + id + "' no ha sido declarado en este ambito.");
                    tipoResultante = "error";
                } else {
                    tipoResultante = s.getTipoDato();
                }
                RESULT = new NodoExp(id.toString(), tipoResultante);
            :}
            | INT_LITERAL:val {: RESULT = new NodoExp(val.toString(), "int"); :}
            | FLOAT_LITERAL:val {: RESULT = new NodoExp(val.toString(), "float"); :}
            | DOUBLE_LITERAL:val {: RESULT = new NodoExp(val.toString(), "double"); :}
            | CHAR_LITERAL:val {: RESULT = new NodoExp(val.toString(), "char"); :}
            | STRING_LITERAL:val {: RESULT = new NodoExp(val.toString(), "String"); :}
            | TRUE {: RESULT = new NodoExp("true", "boolean"); :}
            | FALSE {: RESULT = new NodoExp("false", "boolean"); :}
            | NULL {: RESULT = new NodoExp("null", "null"); :}
            | llamada_metodo:m {: RESULT = m; System.out.println("Regla reconocida: llamada utilizada dentro de expresion"); :}
            ;

condicion ::= expresion:e 
            {: 
                if(!e.tipo.equals("boolean") && !e.tipo.equals("error")) {
                   System.err.println("Error semantico en linea " + eleft + ", columna " + eright + ": La expresion de la condicion debe ser de tipo 'boolean', se encontro '" + e.tipo + "'.");
                }
                RESULT = e;
            :} ;

elemento ::= expresion:e {: RESULT = e; :};

// --- ASIGNACIÓN ---
asignacion ::= IDENTIFIER:id EQ expresion:exp SEMICOLON 
             {: 
                 Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                 if (s == null) {
                     System.err.println("Error semantico en linea " + idleft + ", columna " + idright + ": El identificador '" + id + "' no ha sido declarado.");
                 } else {
                     if (s.getCategoria().equals("CONSTANTE")) {
                         System.err.println("Error semantico en linea " + idleft + ", columna " + idright + ": No se puede reasignar un valor a la constante '" + id + "'.");
                     } else if (!parser.sonTiposCompatibles(s.getTipoDato(), exp.tipo)) {
                         System.err.println("Error semantico en linea " + idleft + ", columna " + idright + ": Incompatibilidad de tipos: No se puede asignar '" + exp.tipo + "' a '" + id + "' de tipo '" + s.getTipoDato() + "'.");
                     }
                 }
                 parser.codigoIntermedio.add(id + " = " + exp.lugar);
                 System.out.println("Regla reconocida: asignacion con expresion");
             :}
             | VAR IDENTIFIER:id COLON tipo_dato:tipo EQ expresion:exp SEMICOLON 
             {: 
                 if (!parser.sonTiposCompatibles(tipo, exp.tipo)) {
                     System.err.println("Error semantico en linea " + idleft + ", columna " + idright + ": Incompatibilidad de tipos al inicializar la variable '" + id + "'. Se esperaba '" + tipo + "' pero se recibio '" + exp.tipo + "'.");
                 }
                 parser.tablaSimbolos.agregarSimbolo(id, "VARIABLE", tipo, "Asignado", idleft, idright); 
                 parser.codigoIntermedio.add(id + " = " + exp.lugar);
                 System.out.println("Regla reconocida: declaracion_asignacion");
             :}
             | VAL IDENTIFIER:id COLON tipo_dato:tipo EQ expresion:exp SEMICOLON 
             {: 
                 if (!parser.sonTiposCompatibles(tipo, exp.tipo)) {
                     System.err.println("Error semantico en linea " + idleft + ", columna " + idright + ": Incompatibilidad de tipos al inicializar la constante '" + id + "'. Se esperaba '" + tipo + "' pero se recibio '" + exp.tipo + "'.");
                 }
                 parser.tablaSimbolos.agregarSimbolo(id, "CONSTANTE", tipo, "Asignado", idleft, idright); 
                 parser.codigoIntermedio.add(id + " = " + exp.lugar);
                 System.out.println("Regla reconocida: declaracion_constante");
             :}
             | error EQ expresion SEMICOLON 
             {: parser.imprimirDiagnostico("Identificador faltante en la asignacion.", "El nombre de una variable.", "Coloca el nombre de la variable antes del signo '='.", "total = 10;"); :}
             | IDENTIFIER EQ error SEMICOLON 
             {: parser.imprimirDiagnostico("Se esperaba una expresion despues del operador de asignacion.", "Un valor, variable o expresion matematica compatible.", "Proporciona un valor despues del '='.", "total = 10;"); :}
             ;

lectura ::= LEER LPAREN lista_identificadores RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de lectura"); :}
          | LEER LPAREN error RPAREN SEMICOLON {: parser.imprimirDiagnostico("Estructura invalida en sentencia de lectura.", "Una lista de variables a leer.", "Revisa los argumentos dentro de leer().", "leer(variable);"); :}
          ;

lista_identificadores ::= IDENTIFIER:id {: parser.codigoIntermedio.add("read " + id); :}
                        | lista_identificadores COMMA IDENTIFIER:id {: parser.codigoIntermedio.add("read " + id); :}
                        | lista_identificadores COMMA error {: parser.imprimirDiagnostico("Coma duplicada o elemento faltante en lista de lectura.", "Un identificador valido.", "Elimina la coma sobrante o agrega el identificador.", "leer(var1, var2);"); :}
                        ;

escritura ::= ESCRIBIR LPAREN lista_elementos RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de escritura"); :}
            | ESCRIBIR LPAREN lista_elementos error SEMICOLON {: parser.imprimirDiagnostico("No se encontro el parentesis de cierre en la escritura.", "Un parentesis ')'.", "Agrega el parentesis de cierre antes del punto y coma.", "escribir(\"Hola\");"); :}
            | ESCRIBIR error SEMICOLON {: parser.imprimirDiagnostico("Estructura invalida en sentencia de escritura.", "Parentesis y contenido a escribir.", "Verifica la sintaxis de la instruccion escribir.", "escribir(\"Hola\");"); :}
            ;

lista_elementos ::= elemento:e {: parser.codigoIntermedio.add("print " + e.lugar); :}
                  | lista_elementos COMMA elemento:e {: parser.codigoIntermedio.add("print " + e.lugar); :} ;

retorno ::= RETURN:r expresion:e SEMICOLON 
          {: 
              parser.validarRetorno(e.tipo, rleft, rright);
              parser.codigoIntermedio.add("return " + e.lugar);
              System.out.println("Regla reconocida: retorno con expresion"); 
          :}
          | RETURN:r SEMICOLON 
          {: 
              parser.validarRetorno("void", rleft, rright);
              parser.codigoIntermedio.add("return");
              System.out.println("Regla reconocida: retorno sin expresion"); 
          :}
          | RETURN error SEMICOLON 
          {: parser.imprimirDiagnostico("Expresion invalida en sentencia return.", "Un valor o variable a retornar.", "Verifica lo que estas intentando retornar.", "return a + b;"); :}
          ;

llamada_metodo ::= IDENTIFIER:id LPAREN RPAREN 
                 {: 
                     String tipo = parser.validarLlamadaMetodo(id, new ArrayList<>(), idleft, idright); 
                     String t = parser.generarTemp();
                     parser.codigoIntermedio.add(t + " = call " + id + ", 0");
                     RESULT = new NodoExp(t, tipo);
                     System.out.println("Regla reconocida: llamada_sin_argumentos"); 
                 :}
                 | IDENTIFIER:id LPAREN lista_argumentos:args RPAREN 
                 {: 
                     String tipo = parser.validarLlamadaMetodo(id, args, idleft, idright); 
                     for (NodoExp arg : args) {
                         parser.codigoIntermedio.add("param " + arg.lugar);
                     }
                     String t = parser.generarTemp();
                     parser.codigoIntermedio.add(t + " = call " + id + ", " + args.size());
                     RESULT = new NodoExp(t, tipo);
                     System.out.println("Regla reconocida: llamada_metodo_con_argumentos"); 
                 :}
                 | IDENTIFIER LPAREN error RPAREN 
                 {: parser.imprimirDiagnostico("Estructura incompleta o invalida en los argumentos de la llamada.", "Una lista de argumentos validos separados por comas.", "Verifica los valores que le pasas al metodo.", "sumar(a, b);"); RESULT = new NodoExp("error", "error"); :}
                 ;

lista_argumentos ::= expresion:e 
                   {: 
                       List<NodoExp> l = new ArrayList<>(); 
                       l.add(e); 
                       RESULT = l; 
                       System.out.println("Regla reconocida: argumento procesado"); 
                   :}
                   | lista_argumentos:l COMMA expresion:e 
                   {: 
                       l.add(e); 
                       RESULT = l; 
                   :}
                   | lista_argumentos:l COMMA error 
                   {: 
                       parser.imprimirDiagnostico("Se encontro una coma adicional o un argumento vacio al final.", "Un valor o expresion despues de la coma.", "Elimina la coma adicional o proporciona el argumento faltante.", "sumar(a, b)"); 
                       l.add(new NodoExp("error", "error"));
                       RESULT = l;
                   :}
                   | error COMMA expresion:e 
                   {: 
                       parser.imprimirDiagnostico("Se esperaba una expresion antes de la coma.", "Un valor o argumento valido.", "Proporciona el argumento faltante o elimina la coma si no es necesaria.", "sumar(a, b)"); 
                       List<NodoExp> l = new ArrayList<>(); 
                       l.add(new NodoExp("error", "error"));
                       l.add(e);
                       RESULT = l;
                   :}
                   ;