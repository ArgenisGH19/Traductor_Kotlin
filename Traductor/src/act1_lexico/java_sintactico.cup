package act1_lexico;

import java_cup.runtime.*;

// ---------------------------------------------------------
// 1. SOBRESCRIBIR METODOS DE ERROR (Sin acentos y sin texto en ingles)
// ---------------------------------------------------------
parser code {:
    @Override
    public void syntax_error(Symbol s) {
        if (s.left >= 0) {
            System.err.println("Error sintactico en linea " + s.left + 
                               ", columna " + s.right + ": se encontro '" + s.value + "'");
        }
    }

    @Override
    public void unrecovered_syntax_error(Symbol s) {
        if (s.left >= 0) {
            System.err.println("Error fatal en linea " + s.left + 
                               ", columna " + s.right + ": se encontro '" + s.value + "'");
        }
        System.err.println("El analisis no puede continuar. Abortando...");
        System.exit(1);
    }
:};

// ---------------------------------------------------------
// 2. DEFINICION DE TERMINALES
// ---------------------------------------------------------
terminal String PACKAGE, IMPORT, CLASS, INTERFACE, OBJECT, FUN, VAL, VAR, TYPEALIAS, TYPEOF;
terminal String IF, ELSE, WHEN, WHILE, FOR, DO, RETURN, BREAK, CONTINUE;
terminal String TRY, CATCH, FINALLY, THROW;
terminal String PUBLIC, PRIVATE, PROTECTED, INTERNAL, ABSTRACT, FINAL, OPEN, OVERRIDE, SEALED, DATA, ENUM, INNER, VALUE, ANNOTATION;
terminal String INFIX, OPERATOR, INLINE, NOINLINE, CROSSINLINE, TAILREC, EXTERNAL, LATEINIT, VARARG, SUSPEND, CONST;
terminal String IS, NOT_IS, AS, AS_SAFE, IN, NOT_IN;
terminal String THIS, SUPER, NULL, TRUE, FALSE;
terminal String CONSTRUCTOR, INIT, COMPANION, EXPECT, ACTUAL, WHERE, OUT;
terminal String PLUS, MINUS, MULT, DIV, MOD;
terminal String EQEQEQ, NEQEQEQ, EQEQ, NEQ, LE, GE, LT, GT, EQ;
terminal String AND, OR, NOT;
terminal String ELVIS, SAFE_CALL, DOUBLE_COLON, RANGE, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK, COMMA, SEMICOLON, DOT, COLON;
terminal String INT_LITERAL, FLOAT_LITERAL, STRING_LITERAL, IDENTIFIER, CHAR_LITERAL, ERROR;
terminal String DOUBLE_LITERAL, INT, FLOAT, DOUBLE, CHAR, BOOLEAN, STRING;
terminal String LEER, ESCRIBIR;

// ---------------------------------------------------------
// 3. DEFINICION DE NO TERMINALES Y PRECEDENCIA
// ---------------------------------------------------------
non terminal programa, estructura_paquete, lista_importaciones, importacion, clase_principal, ruta;
non terminal lista_metodos, metodo, cuerpo_metodo, lista_sentencias, sentencia;
non terminal lectura, escritura, asignacion;
non terminal lista_identificadores, lista_elementos, elemento, expresion;
// Nuevas cositas para reconocer metodos (esto es actualizacion de la tarea 8)
non terminal tipo_dato;
non terminal parametros_optativos, lista_parametros, parametro, tipo_retorno_optativo;
non terminal llamada_metodo, lista_argumentos;
non terminal retorno;

// Precedencia para evitar conflictos en expresiones matemáticas y lógicas
precedence left OR;
precedence left AND;
precedence right NOT;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;

start with programa; 

// ---------------------------------------------------------
// 4. REGLAS GRAMATICALES
// ---------------------------------------------------------

programa ::= estructura_paquete lista_importaciones clase_principal {: System.out.println("Analisis sintactico finalizado correctamente\n"); :}
           | lista_importaciones clase_principal {: System.out.println("Analisis sintactico finalizado correctamente (Sin paquete)\n"); :}
           | estructura_paquete clase_principal {: System.out.println("Analisis sintactico finalizado correctamente (Sin imports)\n"); :}
           | clase_principal {: System.out.println("Analisis sintactico finalizado correctamente (Solo clase)\n"); :}
           | error {: parser.unrecovered_syntax_error(cur_token); :}
           ;

estructura_paquete ::= PACKAGE ruta SEMICOLON {: System.out.println("Paquete reconocido correctamente"); :}
                     | PACKAGE error SEMICOLON {: System.out.println("-> [Recuperacion] Se ignoro error en paquete hasta el ';'"); :}
                     ;

lista_importaciones ::= lista_importaciones importacion
                      | importacion
                      ;

importacion ::= IMPORT ruta SEMICOLON {: System.out.println("Importacion reconocida correctamente"); :}
              | IMPORT error SEMICOLON {: System.out.println("-> [Recuperacion] Se ignoro error en importacion hasta el ';'"); :}
              ;

ruta ::= IDENTIFIER
       | ruta DOT IDENTIFIER
       ;

// La clase principal ahora acepta una lista de métodos (para que pueda haber más de uno)
clase_principal ::= CLASS IDENTIFIER LBRACE lista_metodos RBRACE {: System.out.println("Clase principal reconocida correctamente. Estructura de llaves valida."); :}
                  | CLASS error RBRACE {: System.out.println("-> [Recuperacion] Error en definicion de clase. Se omitio hasta '}'"); :}
                  ;

lista_metodos ::= lista_metodos metodo
                | metodo
                ;

// --- TIPOS DE DATO ---
tipo_dato ::= INT | FLOAT | DOUBLE | BOOLEAN | STRING | CHAR ;

// --- DEFINICIÓN DE MÉTODOS (Sintaxis Kotlin) ---
metodo ::= FUN IDENTIFIER LPAREN parametros_optativos RPAREN tipo_retorno_optativo LBRACE cuerpo_metodo RBRACE 
         {: System.out.println("Regla reconocida: definicion_metodo"); :}
         | FUN IDENTIFIER error LBRACE cuerpo_metodo RBRACE 
         {: System.out.println("-> [Recuperacion] Error sintactico: se esperaba '(' o estructura de parametros invalida en el metodo"); :}
         ;

tipo_retorno_optativo ::= COLON tipo_dato {: System.out.println("Regla reconocida: metodo_con_retorno"); :}
                        | /* vacio */ {: System.out.println("Regla reconocida: metodo_sin_retorno"); :}
                        ;

parametros_optativos ::= lista_parametros {: System.out.println("Regla reconocida: metodo_con_parametros"); :}
                       | /* vacio */ {: System.out.println("Regla reconocida: metodo_sin_parametros"); :}
                       ;

lista_parametros ::= parametro
                   | lista_parametros COMMA parametro
                   | lista_parametros COMMA error {: System.out.println("-> [Recuperacion] Error sintactico: se esperaba un parametro despues de ','"); :}
                   ;

parametro ::= IDENTIFIER COLON tipo_dato {: System.out.println("Regla reconocida: parametro valido"); :}
            | error COLON tipo_dato {: System.out.println("-> [Recuperacion] Error sintactico: se esperaba un identificador para el parametro"); :}
            | IDENTIFIER COLON error {: System.out.println("-> [Recuperacion] Error sintactico: tipo de dato invalido o faltante"); :}
            ;

// --- CUERPO Y SENTENCIAS ---
cuerpo_metodo ::= lista_sentencias {: System.out.println("Regla reconocida: cuerpo de metodo analizado"); :} 
                | /* vacio, para permitir metodos sin sentencias dentro */ {: System.out.println("Regla reconocida: cuerpo de metodo vacio"); :}
                ;

lista_sentencias ::= lista_sentencias sentencia 
                   | sentencia ;

sentencia ::= lectura
            | escritura
            | asignacion
            | llamada_metodo SEMICOLON {: System.out.println("Regla reconocida: llamada utilizada como sentencia"); :}
            | retorno
            | error SEMICOLON {: System.out.println("-> [Recuperacion] Se omitio la estructura con error hasta el ';'"); :}
            ;

// --- RETORNO ---
retorno ::= RETURN expresion SEMICOLON {: System.out.println("Regla reconocida: retorno con expresion"); :}
          | RETURN SEMICOLON {: System.out.println("Regla reconocida: retorno sin expresion"); :}
          | RETURN error SEMICOLON {: System.out.println("-> [Recuperacion] Error sintactico: se esperaba una expresion despues de 'return'"); :}
          ;

// --- LLAMADAS A MÉTODOS ---
llamada_metodo ::= IDENTIFIER LPAREN RPAREN {: System.out.println("Regla reconocida: llamada_sin_argumentos"); :}
                 | IDENTIFIER LPAREN lista_argumentos RPAREN {: System.out.println("Regla reconocida: llamada_metodo_con_argumentos"); :}
                 | IDENTIFIER LPAREN error RPAREN {: System.out.println("-> [Recuperacion] Error sintactico en los argumentos de la llamada"); :}
                 ;

lista_argumentos ::= expresion {: System.out.println("Regla reconocida: argumento procesado"); :}
                   | lista_argumentos COMMA expresion
                   | lista_argumentos COMMA error {: System.out.println("-> [Recuperacion] Error sintactico: se esperaba un argumento despues de ','"); :}
                   | error COMMA expresion {: System.out.println("-> [Recuperacion] Error sintactico: argumento invalido o faltante antes de ','"); :}
                   ;

// --- LECTURA, ESCRITURA Y ASIGNACIÓN ---
lectura ::= LEER LPAREN lista_identificadores RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de lectura"); :}
          | LEER LPAREN error RPAREN SEMICOLON {: System.out.println("-> [Recuperacion] Error: Falta de coma o estructura invalida en lectura"); :}
          ;

lista_identificadores ::= IDENTIFIER
                        | lista_identificadores COMMA IDENTIFIER
                        | lista_identificadores COMMA error {: System.out.println("-> [Recuperacion] Error: Coma duplicada en lista de lectura"); :}
                        ;

escritura ::= ESCRIBIR LPAREN lista_elementos RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de escritura"); :}
            | ESCRIBIR LPAREN lista_elementos error SEMICOLON {: System.out.println("-> [Recuperacion] Error: Falta de ')' en la escritura"); :}
            | ESCRIBIR error SEMICOLON {: System.out.println("-> [Recuperacion] Error: Elemento faltante o coma sobrante en escritura"); :}
            ;

lista_elementos ::= elemento
                  | lista_elementos COMMA elemento
                  ;

elemento ::= STRING_LITERAL
           | expresion 
           ;

asignacion ::= IDENTIFIER EQ expresion SEMICOLON {: System.out.println("Regla reconocida: asignacion con expresion"); :}
             | error EQ expresion SEMICOLON {: System.out.println("-> [Recuperacion] Error: Identificador faltante en la asignacion"); :}
             | IDENTIFIER EQ error SEMICOLON {: System.out.println("-> [Recuperacion] Error: Expresion aritmetica o logica incompleta"); :}
             ;

// --- EXPRESIONES ---
expresion ::= expresion PLUS expresion
            | expresion MINUS expresion
            | expresion MULT expresion
            | expresion DIV expresion
            | expresion MOD expresion
            | expresion AND expresion
            | expresion OR expresion
            | NOT expresion
            | LPAREN expresion RPAREN
            | IDENTIFIER
            | INT_LITERAL
            | FLOAT_LITERAL
            | TRUE
            | FALSE
            | llamada_metodo {: System.out.println("Regla reconocida: llamada utilizada dentro de expresion"); :}
            ;