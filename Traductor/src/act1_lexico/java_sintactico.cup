package act1_lexico;

import java_cup.runtime.*;

parser code {:
    @Override
    public void syntax_error(Symbol s) {
        String token = (s.value != null) ? s.value.toString() : "desconocido";
        System.err.println("Error sintactico en linea " + s.left + 
                           ", columna " + s.right + ": se encontro '" + token + "'");
    }

    @Override
    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        System.err.println("Error fatal en linea " + s.left + ", columna " + s.right);
        System.err.println("El analisis sintactico no puede continuar.");
    }
:};

// --- DECLARACIÓN DE TERMINALES ---
terminal String PACKAGE, IMPORT, CLASS, FUN, VAL, VAR, IF, ELSE, WHEN, WHILE, DO, FOR, IN;
terminal String PUBLIC, PRIVATE, PROTECTED, INTERNAL, FINAL, RETURN, NULL, TRUE, FALSE;
terminal String PLUS, MINUS, MULT, DIV, MOD, EQ, EQEQ, NEQ, LT, LE, GT, GE, AND, OR, NOT;
terminal String ARROW, RANGE, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK, COMMA, SEMICOLON, DOT, COLON;
terminal String INT, FLOAT, DOUBLE, CHAR, BOOLEAN, STRING;
terminal String LEER, ESCRIBIR;
terminal String IDENTIFIER, INT_LITERAL, FLOAT_LITERAL, DOUBLE_LITERAL, CHAR_LITERAL, STRING_LITERAL, ERROR;

// --- DECLARACIÓN DE NO TERMINALES ---
non terminal programa, estructura_paquete, lista_importaciones, importacion, clase_principal, ruta;
non terminal lista_metodos, metodo, cuerpo_metodo, lista_sentencias, sentencia, bloque;
non terminal seleccion, seleccion_multiple, lista_casos, caso, defecto;
non terminal ciclo_mientras, ciclo_hacer_mientras, ciclo_para;
non terminal condicion, expresion, lectura, escritura, asignacion, retorno;
non terminal tipo_dato, parametros_optativos, lista_parametros, parametro, tipo_retorno_optativo;
non terminal lista_identificadores, lista_elementos, elemento, rango_para;

// --- PRECEDENCIA DE OPERADORES Y RESOLUCIÓN DE SHIFT/REDUCE ---
precedence nonassoc IF;
precedence nonassoc ELSE;
precedence left OR;
precedence left AND;
precedence right NOT;
precedence nonassoc EQEQ, NEQ, LT, LE, GT, GE;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;

start with programa;

// --- REGLAS GRAMATICALES ---

programa ::= estructura_paquete lista_importaciones clase_principal
           {: System.out.println("Analisis sintactico finalizado correctamente"); :}
           | lista_importaciones clase_principal
           {: System.out.println("Analisis sintactico finalizado correctamente"); :}
           | estructura_paquete clase_principal
           {: System.out.println("Analisis sintactico finalizado correctamente"); :}
           | clase_principal
           {: System.out.println("Analisis sintactico finalizado correctamente"); :}
           | error {: parser.unrecovered_syntax_error(cur_token); :}
           ;

estructura_paquete ::= PACKAGE ruta SEMICOLON {: System.out.println("Regla reconocida: estructura_paquete"); :}
                     | PACKAGE error SEMICOLON {: System.out.println("-> [Recuperacion] Error en declaracion de paquete"); :}
                     ;

lista_importaciones ::= lista_importaciones importacion
                      | importacion
                      ;

importacion ::= IMPORT ruta SEMICOLON {: System.out.println("Regla reconocida: importacion"); :}
              | IMPORT error SEMICOLON {: System.out.println("-> [Recuperacion] Error en importacion"); :}
              ;

ruta ::= IDENTIFIER
       | ruta DOT IDENTIFIER
       ;

clase_principal ::= CLASS IDENTIFIER LBRACE lista_metodos RBRACE 
                  {: System.out.println("Regla reconocida: clase_principal"); :}
                  | CLASS error RBRACE 
                  {: System.out.println("-> [Recuperacion] Error en definicion de clase"); :}
                  ;

lista_metodos ::= lista_metodos metodo
                | metodo
                ;

// --- MÉTODOS ---
metodo ::= FUN IDENTIFIER LPAREN parametros_optativos RPAREN tipo_retorno_optativo LBRACE cuerpo_metodo RBRACE
         {: System.out.println("Regla reconocida: definicion_metodo"); :}
         | FUN IDENTIFIER LPAREN error RPAREN LBRACE cuerpo_metodo RBRACE
         {: System.out.println("-> [Recuperacion] Error sintactico en los parametros del metodo"); :}
         ;

tipo_retorno_optativo ::= COLON tipo_dato
                        | /* vacio */
                        ;

parametros_optativos ::= lista_parametros
                       | /* vacio */
                       ;

lista_parametros ::= parametro
                   | lista_parametros COMMA parametro
                   ;

parametro ::= IDENTIFIER COLON tipo_dato ;

tipo_dato ::= INT | FLOAT | DOUBLE | CHAR | BOOLEAN | STRING | IDENTIFIER ;

cuerpo_metodo ::= lista_sentencias {: System.out.println("Regla reconocida: cuerpo_metodo"); :}
                | /* vacio */
                ;

// --- BLOQUES Y SENTENCIAS ---
bloque ::= LBRACE lista_sentencias RBRACE {: System.out.println("Regla reconocida: bloque"); :}
         | LBRACE RBRACE {: System.out.println("Regla reconocida: bloque_vacio"); :}
         | LBRACE error RBRACE {: System.out.println("-> [Recuperacion] Error sintactico dentro del bloque"); :}
         ;

lista_sentencias ::= lista_sentencias sentencia
                   | sentencia
                   ;

sentencia ::= seleccion
            | seleccion_multiple
            | ciclo_mientras
            | ciclo_hacer_mientras
            | ciclo_para
            | lectura
            | escritura
            | asignacion
            | retorno
            | error SEMICOLON {: System.out.println("-> [Recuperacion] Se omitio instruccion invalida hasta ';'"); :}
            ;

// --- 1. ESTRUCTURAS SELECTIVAS (Sin conflicto Shift/Reduce) ---
seleccion ::= IF LPAREN condicion RPAREN bloque
            {: System.out.println("Regla reconocida: seleccion_simple"); :}
            | IF LPAREN condicion RPAREN bloque ELSE bloque
            {: System.out.println("Regla reconocida: seleccion_doble"); :}
            | IF error RPAREN bloque
            {: System.err.println("Error sintactico: se esperaba '(' despues de 'if'"); :}
            ;

seleccion_multiple ::= WHEN LPAREN expresion RPAREN LBRACE lista_casos defecto RBRACE
                     {: System.out.println("Regla reconocida: seleccion_multiple"); :}
                     | WHEN LPAREN expresion RPAREN LBRACE lista_casos RBRACE
                     {: System.out.println("Regla reconocida: seleccion_multiple"); :}
                     | WHEN LPAREN error RPAREN LBRACE lista_casos RBRACE
                     {: System.err.println("Error sintactico en expresion de seleccion multiple 'when'"); :}
                     ;

lista_casos ::= lista_casos caso
              | caso
              ;

caso ::= expresion ARROW bloque
       {: System.out.println("Regla reconocida: caso"); :}
       | expresion ARROW sentencia
       {: System.out.println("Regla reconocida: caso"); :}
       ;

defecto ::= ELSE ARROW bloque {: System.out.println("Regla reconocida: defecto"); :}
          | ELSE ARROW sentencia {: System.out.println("Regla reconocida: defecto"); :}
          ;

// --- 2. ESTRUCTURAS ITERATIVAS ---
ciclo_mientras ::= WHILE LPAREN condicion RPAREN bloque
                 {: System.out.println("Regla reconocida: ciclo_mientras"); :}
                 | WHILE LPAREN condicion error bloque
                 {: System.err.println("Error sintactico: se esperaba ')' en la condicion del ciclo"); :}
                 ;

ciclo_hacer_mientras ::= DO bloque WHILE LPAREN condicion RPAREN SEMICOLON
                       {: System.out.println("Regla reconocida: ciclo_hacer_mientras"); :}
                       | DO bloque WHILE LPAREN error RPAREN SEMICOLON
                       {: System.err.println("Error sintactico en la condicion de 'do-while'"); :}
                       ;

ciclo_para ::= FOR LPAREN IDENTIFIER IN rango_para RPAREN bloque
             {: System.out.println("Regla reconocida: ciclo_para"); :}
             | FOR LPAREN IDENTIFIER RPAREN bloque
             {: System.err.println("Error sintactico: se esperaba la seccion de actualizacion/rango del ciclo 'for'"); :}
             ;

rango_para ::= expresion RANGE expresion ;

// --- 3. CONDICIONES Y EXPRESIONES ---
condicion ::= expresion {: System.out.println("Regla reconocida: condicion"); :} ;

expresion ::= expresion PLUS expresion
            | expresion MINUS expresion
            | expresion MULT expresion
            | expresion DIV expresion
            | expresion MOD expresion
            | expresion EQEQ expresion
            | expresion NEQ expresion
            | expresion LT expresion
            | expresion LE expresion
            | expresion GT expresion
            | expresion GE expresion
            | expresion AND expresion
            | expresion OR expresion
            | NOT expresion
            | LPAREN expresion RPAREN
            | IDENTIFIER
            | INT_LITERAL
            | FLOAT_LITERAL
            | DOUBLE_LITERAL
            | CHAR_LITERAL
            | STRING_LITERAL
            | TRUE
            | FALSE
            | NULL
            ;

// --- OTRAS SENTENCIAS ---
lectura ::= LEER LPAREN lista_identificadores RPAREN SEMICOLON
          {: System.out.println("Regla reconocida: lectura"); :}
          ;

lista_identificadores ::= IDENTIFIER
                        | lista_identificadores COMMA IDENTIFIER
                        ;

escritura ::= ESCRIBIR LPAREN lista_elementos RPAREN SEMICOLON
            {: System.out.println("Regla reconocida: escritura"); :}
            ;

lista_elementos ::= elemento
                  | lista_elementos COMMA elemento
                  ;

elemento ::= expresion ;

asignacion ::= IDENTIFIER EQ expresion SEMICOLON
             {: System.out.println("Regla reconocida: asignacion"); :}
             | VAR IDENTIFIER COLON tipo_dato EQ expresion SEMICOLON
             {: System.out.println("Regla reconocida: declaracion_asignacion"); :}
             | VAL IDENTIFIER COLON tipo_dato EQ expresion SEMICOLON
             {: System.out.println("Regla reconocida: declaracion_constante"); :}
             ;

retorno ::= RETURN expresion SEMICOLON {: System.out.println("Regla reconocida: retorno"); :}
          | RETURN SEMICOLON {: System.out.println("Regla reconocida: retorno"); :}
          ;