package act1_lexico;

import java_cup.runtime.*;
import java.util.List;
import java.util.ArrayList;
import java.util.Stack;

parser code {:
    // ¡Nuestra memoria semántica intacta!
    public TablaSimbolos tablaSimbolos = new TablaSimbolos();

    // --- 1. CONTADORES GLOBALES Y VARIABLES DE ESTADO ---
    public int totalErrores = 0;
    public int totalErroresSemanticos = 0;
    public boolean errorFatal = false;
    public boolean metodoTieneReturn = false;
    
    public int ultimaLinea = -1;
    public int ultimaColumna = -1;
    public String ultimoToken = "";

    // --- CÓDIGO DE 3 DIRECCIONES (C3D) Y PILAS DE FLUJO ---
    public List<String> codigoIntermedio = new ArrayList<>();
    private int contadorTemp = 0;
    private int contadorEtiq = 0;

    public String ultimaCondicion = "";
    public Stack<Integer> pilaIndiceIf = new Stack<>();
    public Stack<String> pilaCondicionIf = new Stack<>();
    public Stack<List<String>> pilaBloqueIf = new Stack<>();
    public Stack<String> pilaEtiquetasIf = new Stack<>();

    public Stack<String> pilaInicioCiclo = new Stack<>();
    public Stack<String> pilaFinCiclo = new Stack<>();
    public Stack<String> pilaVarFor = new Stack<>();

    public Stack<String> pilaValorWhen = new Stack<>();
    public Stack<Integer> pilaIndiceWhen = new Stack<>();
    public Stack<List<String>> pilaSaltosWhen = new Stack<>();

    public String generarTemp() {
        return "t" + (++contadorTemp);
    }

    public String generarEtiq() {
        return "L" + (++contadorEtiq);
    }

    public void finalizarWhen(boolean tieneDefecto) {
        tablaSimbolos.salirCiclo();
        int nivel = pilaValorWhen.size();
        pilaValorWhen.pop();
        int idx = pilaIndiceWhen.pop();
        List<String> saltos = pilaSaltosWhen.pop();
        String lFin = generarEtiq();
        if (!tieneDefecto) {
            saltos.add("goto " + lFin);
        }
        String placeholder = "goto L_FIN_WHEN_" + nivel;
        for (int i = idx; i < codigoIntermedio.size(); i++) {
            if (codigoIntermedio.get(i).equals(placeholder)) {
                codigoIntermedio.set(i, "goto " + lFin);
            }
        }
        codigoIntermedio.addAll(idx, saltos);
        codigoIntermedio.add(lFin + ":");
    }

    public void reportarErrorSemantico(String mensaje, int linea, int columna) {
        totalErroresSemanticos++;
        System.err.println("Error semantico en linea " + linea + ", columna " + columna + ": " + mensaje);
    }

    // --- 2. EL ATRAPAMOSCAS ---
    @Override
    public void syntax_error(Symbol s) {
        totalErrores++;
        ultimaLinea = s.left;
        ultimaColumna = s.right;
        ultimoToken = (s.value != null) ? s.value.toString() : "desconocido";
    }

    // --- 3. MANEJO DE ERROR FATAL ---
    @Override
    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        errorFatal = true;
        ultimaLinea = s.left;
        ultimaColumna = s.right;
        throw new Exception("Error sintactico irrecuperable");
    }

    // --- 4. NUESTRO GENERADOR DE DIAGNÓSTICOS ---
    public void imprimirDiagnostico(String descripcion, String esperado, String sugerencia, String ejemplo) {
        System.err.println("========================================================");
        System.err.println("ERROR SINTACTICO #" + totalErrores);
        System.err.println("========================================================");
        System.err.println("Ubicacion: Linea " + ultimaLinea + ", columna " + ultimaColumna);
        System.err.println("Elemento encontrado: '" + ultimoToken + "'\n");
        
        System.err.println("Descripcion:");
        System.err.println(descripcion + "\n");
        
        System.err.println("Elemento esperado:");
        System.err.println(esperado + "\n");
        
        System.err.println("Sugerencia:");
        System.err.println(sugerencia + "\n");
        
        if (ejemplo != null && !ejemplo.isEmpty()) {
            System.err.println("Ejemplo de posible correccion:");
            System.err.println(ejemplo + "\n");
        }
        
        System.err.println("Estado:");
        System.err.println("Error recuperable. El analisis continuara.");
        System.err.println("========================================================\n");
    }

    // --- LÓGICA DE ANÁLISIS SEMÁNTICO Y TIPOS ---
    public String validarOperacionAritmetica(String tipo1, String tipo2, String operador, int linea, int columna) {
        if (tipo1.equals("error") || tipo2.equals("error")) return "error";

        if ((tipo1.equals("int") || tipo1.equals("float") || tipo1.equals("double")) && 
            (tipo2.equals("int") || tipo2.equals("float") || tipo2.equals("double"))) {
            if (tipo1.equals("double") || tipo2.equals("double")) return "double";
            if (tipo1.equals("float") || tipo2.equals("float")) return "float";
            return "int";
        }
        
        reportarErrorSemantico("Incompatibilidad de tipos (Type mismatch): El operador aritmetico '" + operador + "' no es aplicable a los tipos '" + tipo1 + "' y '" + tipo2 + "'.", linea, columna);
        return "error";
    }

    public String validarOperacionLogicaRelacional(String tipo1, String tipo2, String operador, int linea, int columna) {
        if (tipo1.equals("error") || tipo2.equals("error")) return "error";

        boolean esRelacional = operador.matches("<|>|<=|>=|==|!=");
        boolean esLogico = operador.matches("&&|\\|\\|");

        if (esRelacional) {
            if ((tipo1.equals("int") || tipo1.equals("float") || tipo1.equals("double")) && 
                (tipo2.equals("int") || tipo2.equals("float") || tipo2.equals("double"))) {
                return "boolean";
            }
            if ((operador.equals("==") || operador.equals("!=")) && tipo1.equals(tipo2)) {
                return "boolean";
            }
            reportarErrorSemantico("No se pueden comparar los tipos '" + tipo1 + "' y '" + tipo2 + "' con el operador '" + operador + "'.", linea, columna);
        } else if (esLogico) {
            if (tipo1.equals("boolean") && tipo2.equals("boolean")) {
                return "boolean";
            }
            reportarErrorSemantico("El operador logico '" + operador + "' requiere operandos 'boolean', se encontro '" + tipo1 + "' y '" + tipo2 + "'.", linea, columna);
        }
        return "error";
    }

    public boolean sonTiposCompatibles(String tipoDestino, String tipoValor) {
        if (tipoValor.equals("error")) return false;
        if (tipoValor.equals("input")) return true; // Permite asignar readln() a cualquier tipo soportado
        if (tipoDestino.equals(tipoValor)) return true;
        if (tipoDestino.equals("float") && tipoValor.equals("int")) return true;
        if (tipoDestino.equals("double") && (tipoValor.equals("int") || tipoValor.equals("float"))) return true;
        return false;
    }

    public String validarLlamadaMetodo(String id, List<NodoExp> argsExp, int linea, int columna) {
        Simbolo s = tablaSimbolos.obtenerSimbolo(id);
        if (s == null) {
            reportarErrorSemantico("El metodo '" + id + "' no esta declarado.", linea, columna);
            return "error";
        }
        if (!s.getCategoria().equals("METODO")) {
            reportarErrorSemantico("El identificador '" + id + "' no es un metodo.", linea, columna);
            return "error";
        }
        
        List<String> params = s.getTiposParametros();
        if (params.size() != argsExp.size()) {
            reportarErrorSemantico("El metodo '" + id + "' requiere " + params.size() + " argumentos, pero se proporcionaron " + argsExp.size() + ".", linea, columna);
            return "error";
        }
        
        for (int i = 0; i < params.size(); i++) {
            String tipoArg = argsExp.get(i).tipo;
            if (!sonTiposCompatibles(params.get(i), tipoArg)) {
                reportarErrorSemantico("El argumento " + (i+1) + " del metodo '" + id + "' es de tipo '" + tipoArg + "'; se esperaba un tipo compatible con '" + params.get(i) + "'.", linea, columna);
            }
        }
        return s.getTipoDato(); 
    }

    public void validarRetorno(String tipoRetornado, int linea, int columna) {
        String tipoEsperado = tablaSimbolos.getTipoRetornoActual();
        if (!tipoRetornado.equals("error") && !sonTiposCompatibles(tipoEsperado, tipoRetornado)) {
            reportarErrorSemantico("El metodo declara un retorno de tipo '" + tipoEsperado + "', pero la expresion retornada es de tipo '" + tipoRetornado + "'.", linea, columna);
        }
    }

    public void validarBreakContinue(String instruccion, int linea, int columna) {
        if (!tablaSimbolos.estoyEnUnCiclo()) {
            reportarErrorSemantico("La instruccion '" + instruccion + "' no se encuentra dentro de un ciclo o estructura permitida.", linea, columna);
        }
    }
:};

// --- DECLARACIÓN DE TERMINALES (SIN DUPLICADOS) ---
terminal String PACKAGE, IMPORT, CLASS, FUN, VAL, VAR, IF, ELSE, WHEN, WHILE, DO, FOR, IN;
terminal String PUBLIC, PRIVATE, PROTECTED, INTERNAL, FINAL, RETURN, NULL, TRUE, FALSE;
terminal String PLUS, MINUS, MULT, DIV, MOD, EQ, EQEQ, NEQ, LT, LE, GT, GE, AND, OR, NOT;
terminal String ARROW, RANGE, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK, COMMA, SEMICOLON, DOT, COLON;
terminal String INT, FLOAT, DOUBLE, CHAR, BOOLEAN, STRING;
terminal String LEER, ESCRIBIR, PRINT, PRINTLN, READLN, BREAK, CONTINUE;
terminal String IDENTIFIER, INT_LITERAL, FLOAT_LITERAL, DOUBLE_LITERAL, CHAR_LITERAL, STRING_LITERAL, ERROR;

// --- DECLARACIÓN DE NO TERMINALES (SIN DUPLICADOS) ---
non terminal programa, estructura_paquete, lista_importaciones, importacion, ruta;
non terminal lista_clases, clase_principal, marcador_clase, lista_miembros, miembro_clase;
non terminal metodo, marcador_metodo, cuerpo_metodo, lista_sentencias, sentencia, bloque;
non terminal seleccion, m_if_cond, m_else;
non terminal seleccion_multiple, encabezado_when, lista_casos, caso, encabezado_caso, defecto, encabezado_defecto;
non terminal ciclo_mientras, encabezado_while, m_while_cond;
non terminal ciclo_hacer_mientras, encabezado_do;
non terminal ciclo_para, encabezado_para, marcador_ciclo;
non terminal lectura, escritura, asignacion, retorno;
non terminal lista_identificadores, lista_elementos, lista_elementos_ln;
non terminal parametros_optativos, lista_parametros, parametro, tipo_retorno_optativo;

non terminal NodoExp expresion, condicion, elemento, llamada_metodo;
non terminal List<NodoExp> lista_argumentos;
non terminal String tipo_dato;

// --- PRECEDENCIA DE OPERADORES ---
precedence nonassoc IF;
precedence nonassoc ELSE;
precedence left OR;
precedence left AND;
precedence right NOT;
precedence nonassoc EQEQ, NEQ, LT, LE, GT, GE;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;

start with programa;

// --- REGLAS GRAMATICALES GLOBALES ---

programa ::= estructura_paquete lista_importaciones lista_clases
           | lista_importaciones lista_clases
           | estructura_paquete lista_clases
           | lista_clases
           | error 
           {: parser.unrecovered_syntax_error(cur_token); :}
           ;

estructura_paquete ::= PACKAGE ruta SEMICOLON 
                     {: System.out.println("Regla reconocida: estructura_paquete"); :}
                     | PACKAGE error SEMICOLON 
                     {: parser.imprimirDiagnostico("Estructura de paquete malformada.", "Una ruta de paquete valida (ej. com.mi.paquete).", "Asegurate de especificar el nombre del paquete correctamente y cerrar con ';'.", "package com.mi.paquete;"); :}
                     ;

lista_importaciones ::= lista_importaciones importacion | importacion ;

importacion ::= IMPORT ruta SEMICOLON 
              {: System.out.println("Regla reconocida: importacion"); :}
              | IMPORT error SEMICOLON 
              {: parser.imprimirDiagnostico("Declaracion de importacion invalida.", "Una ruta de paquete o clase a importar.", "Verifica la sintaxis de la importacion.", "import java.util.*;"); :}
              ;

ruta ::= IDENTIFIER | ruta DOT IDENTIFIER ;

// --- CLASES Y MIEMBROS DE CLASE ---
lista_clases ::= lista_clases clase_principal | clase_principal ;

marcador_clase ::= CLASS IDENTIFIER:id
                 {:
                     parser.tablaSimbolos.agregarSimbolo(id, "CLASE", "void", "N/A", idleft, idright);
                     parser.tablaSimbolos.entrarAmbito(id);
                     parser.codigoIntermedio.add("\n# Definicion de la clase " + id);
                 :}
                 ;

clase_principal ::= marcador_clase LBRACE lista_miembros RBRACE 
                  {: 
                     parser.tablaSimbolos.salirAmbito(); 
                     System.out.println("Regla reconocida: clase_principal_con_metodos"); 
                  :}
                  | marcador_clase LBRACE RBRACE 
                  {: 
                     parser.tablaSimbolos.salirAmbito(); 
                     System.out.println("Regla reconocida: clase_principal_vacia"); 
                  :}
                  | CLASS error RBRACE 
                  {: parser.imprimirDiagnostico("Error en la definicion de la clase principal.", "Un identificador valido para la clase seguido de llaves {}.", "Revisa el nombre de la clase y su estructura.", "class MiClase { ... }"); :}
                  ;

lista_miembros ::= lista_miembros miembro_clase | miembro_clase ;

miembro_clase ::= metodo | asignacion ;

// --- DEFINICIÓN DE MÉTODOS ---
marcador_metodo ::= FUN IDENTIFIER:id
                  {:
                     String etiq = parser.generarEtiq();
                     parser.metodoTieneReturn = false;
                     parser.tablaSimbolos.agregarSimbolo(id, "METODO", "void", "N/A", idleft, idright);
                     Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                     if (s != null) s.setEtiquetaC3D(etiq);
                     parser.tablaSimbolos.entrarAmbito(id);
                     parser.tablaSimbolos.setTipoRetornoActual("void");
                     parser.codigoIntermedio.add("\n# Definicion del metodo " + id);
                     parser.codigoIntermedio.add(etiq + ":");
                  :}
                  ;

metodo ::= marcador_metodo:m LPAREN parametros_optativos RPAREN tipo_retorno_optativo LBRACE cuerpo_metodo RBRACE
         {: 
             String tipoRet = parser.tablaSimbolos.getTipoRetornoActual();
             if (!tipoRet.equals("void") && !parser.metodoTieneReturn) {
                 String nomMet = parser.tablaSimbolos.getAmbitoActual();
                 parser.reportarErrorSemantico("El metodo '" + nomMet + "' declara un retorno de tipo '" + tipoRet + "' pero no contiene una sentencia 'return'.", mleft, mright);
             }
             parser.tablaSimbolos.salirAmbito(); 
             System.out.println("Regla reconocida: definicion_metodo"); 
         :}
         | FUN IDENTIFIER error LBRACE cuerpo_metodo RBRACE 
         {: parser.imprimirDiagnostico("Falta la lista de parametros delimitada por parentesis en la declaracion del metodo.", "Parentesis () despues del identificador.", "Agrega () despues del nombre del metodo, incluso si no recibe parametros.", "fun iniciar() {"); :}
         ;

tipo_retorno_optativo ::= COLON tipo_dato:t 
                        {: 
                            parser.tablaSimbolos.setTipoRetornoActual(t);
                            Simbolo s = parser.tablaSimbolos.obtenerSimbolo(parser.tablaSimbolos.getAmbitoActual());
                            if(s != null) s.setTipoDato(t);
                            System.out.println("Regla reconocida: metodo_con_retorno"); 
                        :}
                        | /* vacio */ 
                        {: System.out.println("Regla reconocida: metodo_sin_retorno"); :}
                        ;

parametros_optativos ::= lista_parametros {: System.out.println("Regla reconocida: metodo_con_parametros"); :}
                       | /* vacio */ {: System.out.println("Regla reconocida: metodo_sin_parametros"); :}
                       ;

lista_parametros ::= parametro
                   | lista_parametros COMMA parametro
                   | lista_parametros COMMA error 
                   {: parser.imprimirDiagnostico("Se encontro un elemento invalido o coma duplicada en los parametros.", "Un identificador de parametro (ej. a: int).", "Verifica no tener comas duplicadas o parametros vacios.", "fun sumar(a: int, b: int)"); :}
                   ;

parametro ::= IDENTIFIER:id COLON tipo_dato:tipo 
            {: 
                parser.tablaSimbolos.agregarSimbolo(id, "VARIABLE", tipo, "N/A (Parametro)", idleft, idright); 
                parser.tablaSimbolos.registrarParametroEnMetodoActual(tipo);
                System.out.println("Regla reconocida: parametro valido"); 
            :}
            | error COLON tipo_dato 
            {: parser.imprimirDiagnostico("Se esperaba un nombre para el parametro.", "Un identificador valido antes de los dos puntos.", "Asegurate de nombrar el parametro.", "valor: int"); :}
            | IDENTIFIER COLON error 
            {: parser.imprimirDiagnostico("Tipo de dato invalido o faltante en el parametro.", "Un tipo de dato valido (int, float, etc.).", "Declara el tipo de dato despues de los dos puntos.", "valor: int"); :}
            ;

tipo_dato ::= INT {: RESULT = "int"; :} 
            | FLOAT {: RESULT = "float"; :} 
            | DOUBLE {: RESULT = "double"; :} 
            | CHAR {: RESULT = "char"; :} 
            | BOOLEAN {: RESULT = "boolean"; :} 
            | STRING {: RESULT = "String"; :} 
            | IDENTIFIER:id {: RESULT = id; :} 
            ;

cuerpo_metodo ::= lista_sentencias {: System.out.println("Regla reconocida: cuerpo_metodo"); :}
                | /* vacio */ {: System.out.println("Regla reconocida: cuerpo de metodo vacio"); :}
                ;

bloque ::= LBRACE lista_sentencias RBRACE {: System.out.println("Regla reconocida: bloque"); :}
         | LBRACE RBRACE {: System.out.println("Regla reconocida: bloque_vacio"); :}
         | LBRACE error RBRACE {: parser.imprimirDiagnostico("Error de sintaxis dentro del bloque de codigo.", "Instrucciones validas.", "Revisa las sentencias dentro de las llaves { }.", ""); :}
         ;

lista_sentencias ::= lista_sentencias sentencia | sentencia ;

sentencia ::= seleccion | seleccion_multiple | ciclo_mientras | ciclo_hacer_mientras | ciclo_para
            | lectura | escritura | asignacion | retorno
            | llamada_metodo:m SEMICOLON 
            {: System.out.println("Regla reconocida: llamada utilizada como sentencia"); :}
            | BREAK:b SEMICOLON 
            {: 
               parser.validarBreakContinue("break", bleft, bright); 
               if (!parser.pilaFinCiclo.isEmpty()) {
                   parser.codigoIntermedio.add("goto " + parser.pilaFinCiclo.peek());
               }
               System.out.println("Regla reconocida: instruccion break"); 
            :}
            | CONTINUE:c SEMICOLON 
            {: 
               parser.validarBreakContinue("continue", cleft, cright); 
               if (!parser.pilaInicioCiclo.isEmpty()) {
                   parser.codigoIntermedio.add("goto " + parser.pilaInicioCiclo.peek());
               }
               System.out.println("Regla reconocida: instruccion continue"); 
            :}
            | error SEMICOLON {: parser.imprimirDiagnostico("Instruccion no reconocida o malformada.", "Una sentencia valida.", "Verifica la estructura de la instruccion.", "iniciar();"); :}
            ;

// --- 1. ESTRUCTURAS CONDICIONALES (IF - ELSE y WHEN/SWITCH) ---
m_if_cond ::= /* vacio */
            {:
                parser.pilaIndiceIf.push(parser.codigoIntermedio.size());
                parser.pilaCondicionIf.push(parser.ultimaCondicion);
            :}
            ;

m_else ::= /* vacio */
         {:
             int idxInicioIf = parser.pilaIndiceIf.pop();
             String cond = parser.pilaCondicionIf.pop();
             List<String> bloqueIf = new ArrayList<>();
             while (parser.codigoIntermedio.size() > idxInicioIf) {
                 bloqueIf.add(0, parser.codigoIntermedio.remove(parser.codigoIntermedio.size() - 1));
             }
             parser.pilaBloqueIf.push(bloqueIf);
             String lTrue = parser.generarEtiq();
             parser.pilaEtiquetasIf.push(lTrue);
             parser.codigoIntermedio.add("if " + cond + " goto " + lTrue);
         :}
         ;

seleccion ::= IF LPAREN condicion:c RPAREN m_if_cond bloque 
            {: 
                int idxInicioIf = parser.pilaIndiceIf.pop();
                String cond = parser.pilaCondicionIf.pop();
                String lFin = parser.generarEtiq();
                parser.codigoIntermedio.add(idxInicioIf, "if not " + cond + " goto " + lFin);
                parser.codigoIntermedio.add(lFin + ":");
                System.out.println("Regla reconocida: seleccion_simple"); 
            :}
            | IF LPAREN condicion:c RPAREN m_if_cond bloque ELSE m_else bloque 
            {: 
                String lTrue = parser.pilaEtiquetasIf.pop();
                String lFin = parser.generarEtiq();
                List<String> bloqueIf = parser.pilaBloqueIf.pop();
                parser.codigoIntermedio.add("goto " + lFin);
                parser.codigoIntermedio.add(lTrue + ":");
                parser.codigoIntermedio.addAll(bloqueIf);
                parser.codigoIntermedio.add(lFin + ":");
                System.out.println("Regla reconocida: seleccion_doble"); 
            :}
            | IF error RPAREN bloque {: parser.imprimirDiagnostico("Condicion malformada o falta de parentesis de apertura en 'if'.", "Un parentesis '(' seguido de una condicion.", "Agrega el parentesis de apertura para la condicion.", "if (x > 0) {"); :}
            ;

encabezado_when ::= WHEN LPAREN expresion:e RPAREN LBRACE
                  {:
                      String val = e.lugar;
                      if (!val.startsWith("t")) {
                          String t = parser.generarTemp();
                          parser.codigoIntermedio.add(t + " = " + val);
                          val = t;
                      }
                      parser.pilaValorWhen.push(val);
                      parser.pilaIndiceWhen.push(parser.codigoIntermedio.size());
                      parser.pilaSaltosWhen.push(new ArrayList<String>());
                      parser.tablaSimbolos.entrarCiclo();
                  :}
                  ;

seleccion_multiple ::= encabezado_when lista_casos defecto RBRACE 
                     {: 
                         parser.finalizarWhen(true);
                         System.out.println("Regla reconocida: seleccion_multiple"); 
                     :}
                     | encabezado_when lista_casos RBRACE 
                     {: 
                         parser.finalizarWhen(false);
                         System.out.println("Regla reconocida: seleccion_multiple"); 
                     :}
                     | WHEN LPAREN error RPAREN LBRACE lista_casos RBRACE {: parser.imprimirDiagnostico("Expresion invalida en estructura 'when'.", "Una variable o expresion a evaluar.", "Verifica el contenido entre los parentesis del when.", "when (opcion) {"); :}
                     ;

lista_casos ::= lista_casos caso | caso ;

encabezado_caso ::= expresion:e ARROW
                  {:
                      String valWhen = parser.pilaValorWhen.peek();
                      String lCaso = parser.generarEtiq();
                      parser.pilaSaltosWhen.peek().add("if " + valWhen + " == " + e.lugar + " goto " + lCaso);
                      parser.codigoIntermedio.add(lCaso + ":");
                  :}
                  ;

caso ::= encabezado_caso bloque 
       {: 
           parser.codigoIntermedio.add("goto L_FIN_WHEN_" + parser.pilaValorWhen.size());
           System.out.println("Regla reconocida: caso"); 
       :} 
       | encabezado_caso sentencia 
       {: 
           parser.codigoIntermedio.add("goto L_FIN_WHEN_" + parser.pilaValorWhen.size());
           System.out.println("Regla reconocida: caso"); 
       :} ;

encabezado_defecto ::= ELSE ARROW
                     {:
                         String lDef = parser.generarEtiq();
                         parser.pilaSaltosWhen.peek().add("goto " + lDef);
                         parser.codigoIntermedio.add(lDef + ":");
                     :}
                     ;

defecto ::= encabezado_defecto bloque {: System.out.println("Regla reconocida: defecto"); :} 
          | encabezado_defecto sentencia {: System.out.println("Regla reconocida: defecto"); :} ;

// --- 2. BUCLES (WHILE, DO-WHILE, FOR) ---
marcador_ciclo ::= /* vacio */ {: parser.tablaSimbolos.entrarCiclo(); :} ;

encabezado_while ::= WHILE
                   {:
                       String lInicio = parser.generarEtiq();
                       String lFin = parser.generarEtiq();
                       parser.pilaInicioCiclo.push(lInicio);
                       parser.pilaFinCiclo.push(lFin);
                       parser.codigoIntermedio.add(lInicio + ":");
                   :}
                   ;

m_while_cond ::= /* vacio */
               {:
                   String lFin = parser.pilaFinCiclo.peek();
                   parser.codigoIntermedio.add("if not " + parser.ultimaCondicion + " goto " + lFin);
                   parser.tablaSimbolos.entrarCiclo();
               :}
               ;

ciclo_mientras ::= encabezado_while LPAREN condicion:c RPAREN m_while_cond bloque
                 {: 
                     parser.tablaSimbolos.salirCiclo(); 
                     String lInicio = parser.pilaInicioCiclo.pop();
                     String lFin = parser.pilaFinCiclo.pop();
                     parser.codigoIntermedio.add("goto " + lInicio);
                     parser.codigoIntermedio.add(lFin + ":");
                     System.out.println("Regla reconocida: ciclo_mientras"); 
                 :}
                 | encabezado_while LPAREN condicion:c error bloque
                 {: 
                     parser.pilaInicioCiclo.pop();
                     parser.pilaFinCiclo.pop();
                     parser.imprimirDiagnostico("Falta el parentesis de cierre en el ciclo 'while'.", "Un parentesis de cierre ')'.", "Cierra los parentesis de la condicion.", "while (x < 10) {"); 
                 :}
                 ;

encabezado_do ::= DO
                {:
                    String lInicio = parser.generarEtiq();
                    parser.pilaInicioCiclo.push(lInicio);
                    parser.pilaFinCiclo.push("L_END_DO");
                    parser.codigoIntermedio.add(lInicio + ":");
                    parser.tablaSimbolos.entrarCiclo();
                :}
                ;

ciclo_hacer_mientras ::= encabezado_do bloque WHILE LPAREN condicion:c RPAREN SEMICOLON
                       {: 
                           parser.tablaSimbolos.salirCiclo(); 
                           String lInicio = parser.pilaInicioCiclo.pop();
                           parser.pilaFinCiclo.pop();
                           parser.codigoIntermedio.add("if " + c.lugar + " goto " + lInicio);
                           System.out.println("Regla reconocida: ciclo_hacer_mientras"); 
                       :}
                       | encabezado_do bloque WHILE LPAREN error RPAREN SEMICOLON
                       {: 
                           parser.tablaSimbolos.salirCiclo(); 
                           parser.pilaInicioCiclo.pop();
                           parser.pilaFinCiclo.pop();
                           parser.imprimirDiagnostico("Condicion invalida en el ciclo 'do-while'.", "Una expresion booleana.", "Revisa la condicion dentro de los parentesis.", "while (x < 10);"); 
                       :}
                       ;

encabezado_para ::= FOR LPAREN IDENTIFIER:id IN expresion:e1 RANGE expresion:e2 RPAREN
                  {:
                      if (parser.tablaSimbolos.obtenerSimbolo(id) == null) {
                          parser.tablaSimbolos.agregarSimbolo(id, "VARIABLE", "int", "0", idleft, idright);
                      }
                      parser.codigoIntermedio.add(id + " = " + e1.lugar);
                      String lInicio = parser.generarEtiq();
                      String lFin = parser.generarEtiq();
                      parser.pilaInicioCiclo.push(lInicio);
                      parser.pilaFinCiclo.push(lFin);
                      parser.pilaVarFor.push(id);
                      parser.codigoIntermedio.add(lInicio + ":");
                      String tCond = parser.generarTemp();
                      parser.codigoIntermedio.add(tCond + " = " + id + " < " + e2.lugar);
                      parser.codigoIntermedio.add("if not " + tCond + " goto " + lFin);
                      parser.tablaSimbolos.entrarCiclo();
                  :}
                  ;

ciclo_para ::= encabezado_para bloque
             {: 
                 parser.tablaSimbolos.salirCiclo(); 
                 String lInicio = parser.pilaInicioCiclo.pop();
                 String lFin = parser.pilaFinCiclo.pop();
                 String id = parser.pilaVarFor.pop();
                 parser.codigoIntermedio.add(id + " = " + id + " + 1");
                 parser.codigoIntermedio.add("goto " + lInicio);
                 parser.codigoIntermedio.add(lFin + ":");
                 System.out.println("Regla reconocida: ciclo_para"); 
             :}
             | FOR LPAREN IDENTIFIER RPAREN marcador_ciclo bloque
             {: parser.tablaSimbolos.salirCiclo(); parser.imprimirDiagnostico("Se esperaba la seccion de actualizacion o rango en el ciclo 'for'.", "La palabra reservada 'in' seguida de un rango.", "Agrega la palabra 'in' y el rango a iterar.", "for (i in 0..5) {"); :}
             ;

// --- EXPRESIONES CON VERIFICACIÓN DE TIPOS Y GENERACIÓN C3D ---
expresion ::= expresion:e1 PLUS expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "+", e1left, e1right);
                if (tipo.equals("error")) {
                    parser.codigoIntermedio.add("if type(" + e1.lugar + ") != " + e2.tipo + " then error \"Type mismatch\" # Operacion bloqueada");
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " + " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 MINUS expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "-", e1left, e1right);
                if (tipo.equals("error")) {
                    parser.codigoIntermedio.add("if type(" + e1.lugar + ") != " + e2.tipo + " then error \"Type mismatch\" # Operacion bloqueada");
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " - " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 MULT expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "*", e1left, e1right);
                if (tipo.equals("error")) {
                    parser.codigoIntermedio.add("if type(" + e1.lugar + ") != " + e2.tipo + " then error \"Type mismatch\" # Operacion bloqueada");
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " * " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 DIV expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "/", e1left, e1right);
                if (tipo.equals("error")) {
                    parser.codigoIntermedio.add("if type(" + e1.lugar + ") != " + e2.tipo + " then error \"Type mismatch\" # Operacion bloqueada");
                    RESULT = new NodoExp("error", "error");
                } else if (e2.lugar.equals("0") || e2.lugar.equals("0.0") || e2.lugar.equals("0.0f") || e2.lugar.equals("0.0d")) {
                    parser.reportarErrorSemantico("Error matematico: Division entre cero no permitida.", e2left, e2right);
                    RESULT = new NodoExp("error", "error");
                } else {
                    parser.codigoIntermedio.add("if " + e2.lugar + " == 0 then error \"Division by zero\"");
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " / " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 MOD expresion:e2 
            {: 
                String tipo = parser.validarOperacionAritmetica(e1.tipo, e2.tipo, "%", e1left, e1right);
                if (tipo.equals("error")) {
                    parser.codigoIntermedio.add("if type(" + e1.lugar + ") != " + e2.tipo + " then error \"Type mismatch\" # Operacion bloqueada");
                    RESULT = new NodoExp("error", "error");
                } else if (e2.lugar.equals("0") || e2.lugar.equals("0.0") || e2.lugar.equals("0.0f") || e2.lugar.equals("0.0d")) {
                    parser.reportarErrorSemantico("Error matematico: Modulo entre cero no permitido.", e2left, e2right);
                    RESULT = new NodoExp("error", "error");
                } else {
                    parser.codigoIntermedio.add("if " + e2.lugar + " == 0 then error \"Division by zero\"");
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " % " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 EQEQ expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "==", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " == " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 NEQ expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "!=", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " != " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 LT expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "<", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " < " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 LE expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "<=", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " <= " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 GT expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, ">", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " > " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 GE expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, ">=", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " >= " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 AND expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "&&", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " && " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | expresion:e1 OR expresion:e2 
            {: 
                String tipo = parser.validarOperacionLogicaRelacional(e1.tipo, e2.tipo, "||", e1left, e1right);
                if (tipo.equals("error")) {
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = " + e1.lugar + " || " + e2.lugar);
                    RESULT = new NodoExp(t, tipo);
                }
            :}
            | NOT expresion:e1 
            {: 
                if(!e1.tipo.equals("boolean") && !e1.tipo.equals("error")) {
                    parser.reportarErrorSemantico("El operador '!' requiere un operando 'boolean'.", e1left, e1right);
                    RESULT = new NodoExp("error", "error");
                } else {
                    String t = parser.generarTemp();
                    parser.codigoIntermedio.add(t + " = !" + e1.lugar);
                    RESULT = new NodoExp(t, "boolean"); 
                }
            :}
            | LPAREN expresion:e1 RPAREN {: RESULT = e1; :}
            | IDENTIFIER:id 
            {: 
                Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                String tipoResultante;
                if (s == null) {
                    parser.reportarErrorSemantico("El identificador '" + id + "' no ha sido declarado en este ambito.", idleft, idright);
                    tipoResultante = "error";
                } else {
                    if (s.getValor() != null && s.getValor().equals("Sin inicializar")) {
                        parser.reportarErrorSemantico("La variable '" + id + "' se esta utilizando antes de ser inicializada.", idleft, idright);
                    }
                    tipoResultante = s.getTipoDato();
                }
                RESULT = new NodoExp(id.toString(), tipoResultante);
            :}
            | INT_LITERAL:val {: RESULT = new NodoExp(val.toString(), "int"); :}
            | FLOAT_LITERAL:val {: RESULT = new NodoExp(val.toString(), "float"); :}
            | DOUBLE_LITERAL:val {: RESULT = new NodoExp(val.toString(), "double"); :}
            | CHAR_LITERAL:val {: RESULT = new NodoExp(val.toString(), "char"); :}
            | STRING_LITERAL:val {: RESULT = new NodoExp(val.toString(), "String"); :}
            | TRUE {: RESULT = new NodoExp("true", "boolean"); :}
            | FALSE {: RESULT = new NodoExp("false", "boolean"); :}
            | NULL {: RESULT = new NodoExp("null", "null"); :}
            | READLN LPAREN RPAREN {: RESULT = new NodoExp("readln", "input"); :}
            | llamada_metodo:m {: RESULT = m; System.out.println("Regla reconocida: llamada utilizada dentro de expresion"); :}
            ;

condicion ::= expresion:e 
            {: 
                if(!e.tipo.equals("boolean") && !e.tipo.equals("error")) {
                   parser.reportarErrorSemantico("La expresion de la condicion debe ser de tipo 'boolean', se encontro '" + e.tipo + "'.", eleft, eright);
                }
                parser.ultimaCondicion = e.lugar;
                RESULT = e;
            :} ;

elemento ::= expresion:e {: RESULT = e; :};

// --- DECLARACIONES Y ASIGNACIONES (CON SOPORTE PARA READLN) ---
asignacion ::= IDENTIFIER:id EQ expresion:exp SEMICOLON 
             {: 
                 Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                 if (s == null) {
                     parser.reportarErrorSemantico("El identificador '" + id + "' no ha sido declarado.", idleft, idright);
                 } else if (s.getCategoria().equals("CONSTANTE")) {
                     parser.reportarErrorSemantico("No se puede reasignar un valor a la constante '" + id + "'.", idleft, idright);
                 } else if (!exp.tipo.equals("error")) {
                     if (!parser.sonTiposCompatibles(s.getTipoDato(), exp.tipo)) {
                         parser.reportarErrorSemantico("Incompatibilidad de tipos: No se puede asignar '" + exp.tipo + "' a '" + id + "' de tipo '" + s.getTipoDato() + "'.", idleft, idright);
                         parser.codigoIntermedio.add("# Asignacion a '" + id + "' bloqueada por incompatibilidad de tipos");
                     } else {
                         s.setValor("Asignado");
                         if (exp.lugar.equals("readln")) {
                             parser.codigoIntermedio.add("read " + id);
                         } else {
                             parser.codigoIntermedio.add(id + " = " + exp.lugar);
                         }
                     }
                 } else {
                     parser.codigoIntermedio.add("# Asignacion a '" + id + "' bloqueada por error en la expresion");
                 }
                 System.out.println("Regla reconocida: asignacion con expresion");
             :}
             | VAR IDENTIFIER:id COLON tipo_dato:tipo EQ expresion:exp SEMICOLON 
             {: 
                 String cat = parser.tablaSimbolos.determinarCategoriaVariable();
                 parser.tablaSimbolos.agregarSimbolo(id, cat, tipo, "Asignado", idleft, idright); 
                 if (!exp.tipo.equals("error")) {
                     if (!parser.sonTiposCompatibles(tipo, exp.tipo)) {
                         parser.reportarErrorSemantico("Incompatibilidad de tipos al inicializar la variable '" + id + "'. Se esperaba '" + tipo + "' pero se recibio '" + exp.tipo + "'.", idleft, idright);
                         parser.codigoIntermedio.add("# Inicializacion de '" + id + "' bloqueada por incompatibilidad de tipos");
                     } else if (exp.lugar.equals("readln")) {
                         parser.codigoIntermedio.add("read " + id);
                     } else {
                         parser.codigoIntermedio.add(id + " = " + exp.lugar);
                     }
                 } else {
                     parser.codigoIntermedio.add("# Inicializacion de '" + id + "' bloqueada por error en la expresion");
                 }
                 System.out.println("Regla reconocida: declaracion_asignacion");
             :}
             | VAR IDENTIFIER:id COLON tipo_dato:tipo SEMICOLON 
             {: 
                 String cat = parser.tablaSimbolos.determinarCategoriaVariable();
                 parser.tablaSimbolos.agregarSimbolo(id, cat, tipo, "Sin inicializar", idleft, idright); 
                 System.out.println("Regla reconocida: declaracion_variable");
             :}
             | VAL IDENTIFIER:id COLON tipo_dato:tipo EQ expresion:exp SEMICOLON 
             {: 
                 parser.tablaSimbolos.agregarSimbolo(id, "CONSTANTE", tipo, "Asignado", idleft, idright); 
                 if (!exp.tipo.equals("error")) {
                     if (!parser.sonTiposCompatibles(tipo, exp.tipo)) {
                         parser.reportarErrorSemantico("Incompatibilidad de tipos al inicializar la constante '" + id + "'. Se esperaba '" + tipo + "' pero se recibio '" + exp.tipo + "'.", idleft, idright);
                         parser.codigoIntermedio.add("# Inicializacion de constante '" + id + "' bloqueada por incompatibilidad de tipos");
                     } else if (exp.lugar.equals("readln")) {
                         parser.codigoIntermedio.add("read " + id);
                     } else {
                         parser.codigoIntermedio.add(id + " = " + exp.lugar);
                     }
                 } else {
                     parser.codigoIntermedio.add("# Inicializacion de constante '" + id + "' bloqueada por error en la expresion");
                 }
                 System.out.println("Regla reconocida: declaracion_constante");
             :}
             | error EQ expresion SEMICOLON 
             {: parser.imprimirDiagnostico("Identificador faltante en la asignacion.", "El nombre de una variable.", "Coloca el nombre de la variable antes del signo '='.", "total = 10;"); :}
             | IDENTIFIER EQ error SEMICOLON 
             {: parser.imprimirDiagnostico("Se esperaba una expresion despues del operador de asignacion.", "Un valor, variable o expresion matematica compatible.", "Proporciona un valor despues del '='.", "total = 10;"); :}
             ;

lectura ::= LEER LPAREN lista_identificadores RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de lectura"); :}
          | LEER LPAREN error RPAREN SEMICOLON {: parser.imprimirDiagnostico("Estructura invalida en sentencia de lectura.", "Una lista de variables a leer.", "Revisa los argumentos dentro de leer().", "leer(variable);"); :}
          ;

lista_identificadores ::= IDENTIFIER:id {: parser.codigoIntermedio.add("read " + id); :}
                        | lista_identificadores COMMA IDENTIFIER:id {: parser.codigoIntermedio.add("read " + id); :}
                        | lista_identificadores COMMA error {: parser.imprimirDiagnostico("Coma duplicada o elemento faltante en lista de lectura.", "Un identificador valido.", "Elimina la coma sobrante o agrega el identificador.", "leer(var1, var2);"); :}
                        ;

escritura ::= ESCRIBIR LPAREN lista_elementos_ln RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de escritura (escribir)"); :}
            | PRINTLN LPAREN lista_elementos_ln RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de escritura (println)"); :}
            | PRINTLN LPAREN RPAREN SEMICOLON {: parser.codigoIntermedio.add("println \"\""); System.out.println("Regla reconocida: println vacio"); :}
            | PRINT LPAREN lista_elementos RPAREN SEMICOLON {: System.out.println("Regla reconocida: sentencia de escritura (print)"); :}
            | ESCRIBIR LPAREN lista_elementos_ln error SEMICOLON {: parser.imprimirDiagnostico("No se encontro el parentesis de cierre en la escritura.", "Un parentesis ')'.", "Agrega el parentesis de cierre antes del punto y coma.", "escribir(\"Hola\");"); :}
            | PRINTLN LPAREN lista_elementos_ln error SEMICOLON {: parser.imprimirDiagnostico("No se encontro el parentesis de cierre en println.", "Un parentesis ')'.", "Agrega el parentesis de cierre antes del punto y coma.", "println(d);"); :}
            | PRINT LPAREN lista_elementos error SEMICOLON {: parser.imprimirDiagnostico("No se encontro el parentesis de cierre en print.", "Un parentesis ')'.", "Agrega el parentesis de cierre antes del punto y coma.", "print(\"Valor: \");"); :}
            | ESCRIBIR error SEMICOLON {: parser.imprimirDiagnostico("Estructura invalida en sentencia de escritura.", "Parentesis y contenido a escribir.", "Verifica la sintaxis de la instruccion escribir.", "escribir(\"Hola\");"); :}
            ;

lista_elementos ::= elemento:e {: parser.codigoIntermedio.add("print " + e.lugar); :}
                  | lista_elementos COMMA elemento:e {: parser.codigoIntermedio.add("print " + e.lugar); :} ;

lista_elementos_ln ::= elemento:e {: parser.codigoIntermedio.add("println " + e.lugar); :}
                     | lista_elementos_ln COMMA elemento:e {: parser.codigoIntermedio.add("println " + e.lugar); :} ;

retorno ::= RETURN:r expresion:e SEMICOLON 
          {: 
              parser.metodoTieneReturn = true;
              parser.validarRetorno(e.tipo, rleft, rright);
              parser.codigoIntermedio.add("return " + e.lugar);
              System.out.println("Regla reconocida: retorno con expresion");
          :}
          | RETURN:r SEMICOLON 
          {: 
              parser.validarRetorno("void", rleft, rright);
              parser.codigoIntermedio.add("return");
              System.out.println("Regla reconocida: retorno sin expresion"); 
          :}
          | RETURN error SEMICOLON 
          {: parser.imprimirDiagnostico("Expresion invalida en sentencia return.", "Un valor o variable a retornar.", "Verifica lo que estas intentando retornar.", "return a + b;"); :}
          ;

// --- LLAMADAS A MÉTODOS Y CREACIÓN DE OBJETOS ---
llamada_metodo ::= IDENTIFIER:id LPAREN RPAREN 
                 {: 
                     Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                     if (s != null && s.getCategoria().equals("CLASE")) {
                         parser.codigoIntermedio.add("# Creacion del objeto " + id);
                         RESULT = new NodoExp("create " + id, id);
                         System.out.println("Regla reconocida: creacion_objeto");
                     } else {
                         String tipo = parser.validarLlamadaMetodo(id, new ArrayList<>(), idleft, idright); 
                         String etiq = (s != null && !s.getEtiquetaC3D().isEmpty()) ? s.getEtiquetaC3D() : id;
                         parser.codigoIntermedio.add("call " + etiq);
                         RESULT = new NodoExp("return_value", tipo);
                         System.out.println("Regla reconocida: llamada_sin_argumentos"); 
                     }
                 :}
                 | IDENTIFIER:id LPAREN lista_argumentos:args RPAREN 
                 {: 
                     String tipo = parser.validarLlamadaMetodo(id, args, idleft, idright); 
                     Simbolo s = parser.tablaSimbolos.obtenerSimbolo(id);
                     String etiq = (s != null && !s.getEtiquetaC3D().isEmpty()) ? s.getEtiquetaC3D() : id;
                     parser.codigoIntermedio.add("call " + etiq);
